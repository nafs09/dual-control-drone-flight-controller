#pragma once
#include <cmath>

namespace FC {
    namespace Estimation {

        struct Vector3f {
            float x, y, z;
            Vector3f() : x(0), y(0), z(0) {}
            Vector3f(float X, float Y, float Z) :x(X), y(Y), z(Z) {}
            Vector3f operator+(const Vector3f& o) const { return { x + o.x,y + o.y,z + o.z }; }
            Vector3f operator-(const Vector3f& o) const { return { x - o.x,y - o.y,z - o.z }; }
            Vector3f operator*(float s) const { return { x * s,y * s,z * s }; }
            Vector3f& operator+=(const Vector3f& o) { x += o.x; y += o.y; z += o.z; return *this; }
            float norm() const { return std::sqrt(x * x + y * y + z * z); }
            Vector3f normalised() const { float n = norm(); return n > 1e-6f ? (*this) * (1.f / n) : Vector3f(); }
        };

        struct Quaternionf {
            float w, x, y, z;
            Quaternionf() :w(1), x(0), y(0), z(0) {}
            void normalise() {
                float n = std::sqrt(w * w + x * x + y * y + z * z);
                if (n > 1e-6f) { w /= n; x /= n; y /= n; z /= n; }
            }
            void toRotationMatrix(float R[3][3]) const {
                float xx = x * x, yy = y * y, zz = z * z;
                float xy = x * y, xz = x * z, yz = y * z;
                float wx = w * x, wy = w * y, wz = w * z;
                R[0][0] = 1 - 2 * (yy + zz); R[0][1] = 2 * (xy - wz);   R[0][2] = 2 * (xz + wy);
                R[1][0] = 2 * (xy + wz);   R[1][1] = 1 - 2 * (xx + zz); R[1][2] = 2 * (yz - wx);
                R[2][0] = 2 * (xz - wy);   R[2][1] = 2 * (yz + wx);   R[2][2] = 1 - 2 * (xx + yy);
            }
            Vector3f rotateInverse(const Vector3f& v) const {
                float R[3][3]; toRotationMatrix(R);
                return { R[0][0] * v.x + R[1][0] * v.y + R[2][0] * v.z,
                         R[0][1] * v.x + R[1][1] * v.y + R[2][1] * v.z,
                         R[0][2] * v.x + R[1][2] * v.y + R[2][2] * v.z };
            }
            static Quaternionf expMap(const Vector3f& v) {
                float a = std::sqrt(v.x * v.x + v.y * v.y + v.z * v.z);
                float sa = (a > 1e-6f) ? std::sin(a) / a : 1.f;
                return { std::cos(a), v.x * sa, v.y * sa, v.z * sa };
            }
            Quaternionf operator*(const Quaternionf& q) const {
                return {
                    w * q.w - x * q.x - y * q.y - z * q.z,
                    w * q.x + x * q.w + y * q.z - z * q.y,
                    w * q.y - x * q.z + y * q.w + z * q.x,
                    w * q.z + x * q.y - y * q.x + z * q.w
                };
            }
        };

        struct Config {
            float init_pos_var, init_vel_var, init_att_var;
            float init_bg_var, init_ba_var, init_tau_m_var;
            float init_bmag_var, init_bbaro_var, init_sbaro_var;
            float init_wind_var;

            float tau_m_nominal;
            float tau_gyro_bias, tau_accel_bias, tau_motor;
            float tau_mag, tau_baro, tau_baro_scale, tau_wind;

            float k_drag;

            float sigma_accel, sigma_gyro, sigma_bg, sigma_ba;
            float sigma_tau_m, sigma_bmag, sigma_bbaro, sigma_sbaro;
            float sigma_wind_h, sigma_wind_v;

            float gps_r_pos_floor, gps_r_vel_floor;
            float nis_1dof, nis_3dof;

            float mag_ref_strength;
            float mag_r_base;

            float motor_odot_thresh;
        };

        constexpr int N = 24;

        /* State indices */
        enum {
            IDX_POS = 0,
            IDX_VEL = 3,
            IDX_ATT = 6,
            IDX_BG = 9,
            IDX_BA = 12,
            IDX_TAU_M = 15,
            IDX_BMAG = 16,
            IDX_BBARO = 19,
            IDX_SBARO = 20,
            IDX_WIND = 21
        };

        struct Preintegrated {
            Vector3f dp{ 0,0,0 };
            Vector3f dv{ 0,0,0 };
            float dt_acc = 0;
            int count = 0;
            void reset() { dp = { 0,0,0 }; dv = { 0,0,0 }; dt_acc = 0; count = 0; }
        };

        class EKF {
        public:
            EKF();
            EKF(const Config& c);
            void init(const Vector3f&, const Vector3f&, const Quaternionf&);

            void accumulateIMU(const Vector3f&, const Vector3f&, const Quaternionf&, float);
            void predict(const Quaternionf&, float);

            void updateGPS(const Vector3f&, const Vector3f&, float, float, float, float, int);
            void updateBaro(float, float, float);
            void updateGPSAltitude(float, float);
            void updateMag(const Vector3f&, const Vector3f&, float);
            void updateMotor(float, float, float, float);
            void setWindPrior(const Vector3f&, float);

            void getCovDiag(float diag[N]) const;

        private:
            Config cfg_;
            bool initialised_ = false;

            Vector3f pos_, vel_, gyroBias_, accelBias_, magBias_, wind_;
            Quaternionf q_;
            float tau_m_, baroBias_, baroScale_;

            float P_[N][N];
            Preintegrated pre_;

            int gpsRejCount_ = 0, baroRejCount_ = 0, magRejCount_ = 0, motorRejCount_ = 0;

            void buildF(float F[N][N], const Vector3f&, const Vector3f&, const Quaternionf&) const;
            void vanLoan(const float F[N][N], float dt, float Phi[N][N], float Qd[N][N]) const;

            template<int M>
            bool kalmanUpdate(const float H[M][N], const float R[M], const float innov[M], float nis_thresh);

            void injectCorrection(const float dx[N]);
            void resetCovariance(const Vector3f&);
        };

    }
} // FC::Estimation
#pragma once
