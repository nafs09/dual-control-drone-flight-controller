#include "../core/shared_state.hpp"
#include "../drivers/lsm6dsv.hpp"
#include "../estimation/invariant_ekf.hpp"
#include "../estimation/mahony_ahrs.hpp"
#include "../flight_modes/flight_mode_fsm.hpp"
#include "../communication/crsf.hpp"
#include "../communication/ubx_parser.hpp"
#include "../actuation/dshot.hpp"
#include "../safety/safety_monitor.hpp"
#include "../simulation/sim_interface.hpp"
#include "../../Inc/fc_config.h"
#include "stm32f7xx_hal.h"
#include "usbd_cdc_if.h"    /* BUG FIX #6 / #7: MAVLink now via USB CDC, not USART3 */
#include "cmsis_os.h"
#include <cmath>
#include <cstring>

/* ============================================================
 *  system_init.cpp
 *
 *  BUG FIX #5: System_Init was truncated. Mutexes, semaphores,
 *  and all RTOS primitives were never created, meaning the first
 *  osMutexAcquire() would hard-fault. Fully rewritten here.
 *
 *  BUG FIX #6: mavTxMutex was used for debug UART in the original
 *  safety.c, creating a race between the safety monitor and the
 *  MAVLink task. MAVLink now uses USB CDC (separate, non-shared
 *  path). USART3 is freed for Motor 3 half-duplex DSHOT.
 *
 *  BUG FIX #7: SD card was opened/closed on every log write,
 *  causing ~100 ms FatFS seek-and-flush latency per entry.
 *  LoggerTask now opens the file once at startup and flushes
 *  on a timer (LOG_SD_FLUSH_MS = 500 ms).
 *
 *  BUG FIX #PINS (UART7 → USART3):
 *  Motor 4 was previously assigned to UART7. UART7 pins are on
 *  Port E (PE7/PE8), not accessible in LQFP64. Motor 4 is now
 *  on USART6 (PC6). USART3 (PB10) is Motor 3.
 *
 *  TASK SCHEDULE:
 *  ┌──────────────────┬──────────┬──────────┬─────────────┐
 *  │ Task             │ Rate     │ Stack(W) │ Priority    │
 *  ├──────────────────┼──────────┼──────────┼─────────────┤
 *  │ ControlLoop      │ ~3840 Hz*│ 768      │ Realtime    │
 *  │ SafetyMonitor    │ 100 Hz   │ 256      │ High        │
 *  │ CRSFTask         │ ~500 Hz  │ 256      │ AboveNormal │
 *  │ BaroTask         │ 50 Hz    │ 256      │ Normal      │
 *  │ MagTask          │ 100 Hz   │ 384      │ Normal      │
 *  │ GPSTask          │ 10 Hz    │ 384      │ Normal      │
 *  │ MAVLinkTask      │ 10 Hz    │ 512      │ Low         │
 *  │ LoggerTask       │ queue    │ 512      │ Idle+1      │
 *  └──────────────────┴──────────┴──────────┴─────────────┘
 *  * ControlLoop blocks on imuDrdySem; timing is hardware-driven.
 * ============================================================ */

namespace FC {

/* ---- Global singletons ------------------------------------ */
SharedState g_state;

static Drivers::LSM6DSV           g_imu;
static Estimation::InvEKF         g_inekf;
static Estimation::MahonyAHRS     g_mahony;
static FlightModes::FlightModeFSM g_fsm;
static Communication::CRSFParser  g_crsf;
static Communication::UBXParser   g_ubx;
static Safety::SafetyMonitor      g_safety;
static bool g_dshotReady = false;
static uint8_t g_gpsRxByte = 0;
static uint8_t g_gpsRxRing[256] = {};
static volatile uint16_t g_gpsRxHead = 0, g_gpsRxTail = 0;
static volatile uint32_t g_gpsRxOverruns = 0;

/* Copy the navigation filter's gyro-bias estimate into the high-rate AHRS.
 * Mutexes are acquired separately so no code takes navMtx and ahMtx at once. */
static void syncMahonyGyroBiasFromInvEKF() {
    Vector3f bias;
    osMutexAcquire(g_state.navMtx, osWaitForever);
    bias = g_inekf.getGyroBias();
    osMutexRelease(g_state.navMtx);
    osMutexAcquire(g_state.ahMtx, osWaitForever);
    g_mahony.setGyroBias(bias);
    osMutexRelease(g_state.ahMtx);
}

static void gpsRxPushFromIsr(uint8_t byte) {
    const uint16_t head = g_gpsRxHead;
    const uint16_t next = static_cast<uint16_t>((head + 1u) & 0x00FFu);
    if (next == g_gpsRxTail) {
        ++g_gpsRxOverruns;
        return;
    }
    g_gpsRxRing[head] = byte;
    __DMB();
    g_gpsRxHead = next;
}

static bool gpsRxPop(uint8_t& byte) {
    const uint16_t tail = g_gpsRxTail;
    if (tail == g_gpsRxHead) return false;
    __DMB();
    byte = g_gpsRxRing[tail];
    g_gpsRxTail = static_cast<uint16_t>((tail + 1u) & 0x00FFu);
    return true;
}

/* External HAL handles — generated by CubeMX */
extern SPI_HandleTypeDef  hspi1;         /* IMU + Baro          */
extern UART_HandleTypeDef huart1;        /* GPS                 */
extern UART_HandleTypeDef huart2;        /* CRSF/ELRS           */
/* BUG FIX #PINS: huart3 is now Motor 3 (was MAVLink).
 *                huart6 is Motor 4 (was incorrectly UART7).   */
extern UART_HandleTypeDef huart3;        /* Motor 3 — USART3    */
extern UART_HandleTypeDef huart4;        /* Motor 1 — UART4     */
extern UART_HandleTypeDef huart5;        /* Motor 2 — UART5     */
extern UART_HandleTypeDef huart6;        /* Motor 4 — USART6    */
extern IWDG_HandleTypeDef hiwdg;
extern ADC_HandleTypeDef  hadc1;

/* ---- DWT cycle counter for µs timing --------------------- */
static void dwt_init() {
    CoreDebug->DEMCR |= CoreDebug_DEMCR_TRCENA_Msk;
    DWT->CYCCNT = 0;
    DWT->CTRL  |= DWT_CTRL_CYCCNTENA_Msk;
}
static uint32_t dwt_us() {
    return DWT->CYCCNT / (FC_SYSCLK_HZ / 1000000UL);
}

/* ============================================================
 *  EXTI4 IRQ — IMU DRDY on PC4
 *  Keep absolutely minimal: no FP, no HAL, no mutex.
 * ============================================================ */
extern "C" void EXTI4_IRQHandler(void) {
    if (__HAL_GPIO_EXTI_GET_IT(IMU_DRDY_PIN)) {
        __HAL_GPIO_EXTI_CLEAR_IT(IMU_DRDY_PIN);
        g_state.imuDrdyCount++;
        /* osSemaphoreRelease is safe from ISR in FreeRTOS */
        osSemaphoreRelease(g_state.imuDrdySem);
    }
}

/* ============================================================
 *  USART2 RX IRQ — CRSF byte-by-byte receive
 * ============================================================ */
extern "C" void USART2_IRQHandler(void) {
    if (huart2.Instance->ISR & USART_ISR_RXNE) {
        uint8_t b = (uint8_t)huart2.Instance->RDR;
        g_crsf.feedByte(b);
    }
    HAL_UART_IRQHandler(&huart2);
}

extern "C" void USART1_IRQHandler(void) {
    HAL_UART_IRQHandler(&huart1);
}

/* ============================================================
 *  DSHOT TX/RX callbacks
 *  BUG FIX #PINS: Motor 3 = &huart3 (USART3/PB10)
 *                 Motor 4 = &huart6 (USART6/PC6)
 *                 No reference to huart7 (doesn't exist in LQFP64)
 * ============================================================ */
extern "C" void HAL_UART_TxCpltCallback(UART_HandleTypeDef* h) {
    if      (h == &huart4) Drivers::DShot::onTxComplete(0);
    else if (h == &huart5) Drivers::DShot::onTxComplete(1);
    else if (h == &huart3) Drivers::DShot::onTxComplete(2);
    else if (h == &huart6) Drivers::DShot::onTxComplete(3);
}
extern "C" void HAL_UART_RxCpltCallback(UART_HandleTypeDef* h) {
    if      (h == &huart4) Drivers::DShot::onRxComplete(0);
    else if (h == &huart5) Drivers::DShot::onRxComplete(1);
    else if (h == &huart3) Drivers::DShot::onRxComplete(2);
    else if (h == &huart6) {
        Drivers::DShot::onRxComplete(3);
        Drivers::DShot::updateAvgFreq();   /* After all 4 RX phases */
    } else if (h == &huart1) {
        gpsRxPushFromIsr(g_gpsRxByte);
        (void)HAL_UART_Receive_IT(&huart1, &g_gpsRxByte, 1);
    }
}

/* ============================================================
 *  CONTROL LOOP TASK  (~3840 Hz, IMU DRDY paced)
 * ============================================================ */
static void ControlLoopTask(void* /*arg*/) {
    osDelay(100);   /* Let sensors stabilise */
    g_mahony.reset(Quaternionf::identity());
    g_inekf.init({0,0,0}, {0,0,0}, Quaternionf::identity());

    uint32_t tPrev = dwt_us();

    for (;;) {
        /* Block until IMU DRDY — hardware-paced, no drift */
        osSemaphoreAcquire(g_state.imuDrdySem, osWaitForever);

        uint32_t tNow = dwt_us();
        float dt = (float)(tNow - tPrev) * 1e-6f;
        tPrev = tNow;
        if (dt <= 0.f || dt > 0.01f) dt = 1.f / CTRL_LOOP_HZ;

        uint32_t t0 = dwt_us();

        /* 1. Read IMU from hardware or the injected simulation sample. */
        Vector3f gyro, accel;
        bool imuSampleValid = true;
        if (Simulation::SimInterface::isSimulation()) {
            osMutexAcquire(g_state.imuMtx, osWaitForever);
            gyro = g_state.gyro_raw_rps; accel = g_state.accel_mps2;
            osMutexRelease(g_state.imuMtx);
        } else {
            imuSampleValid = g_imu.readRaw(gyro, accel);
        }
        if (!imuSampleValid) {
            osMutexAcquire(g_state.imuMtx, osWaitForever);
            g_state.imuReadError = true;
            osMutexRelease(g_state.imuMtx);
            osMutexAcquire(g_state.safetyMtx, osWaitForever);
            g_state.errorFlags |= FC_ERR_IMU;
            g_state.killMotors = true;
            osMutexRelease(g_state.safetyMtx);
            const uint16_t stop[4] = {0, 0, 0, 0};
            osMutexAcquire(g_state.motMtx, osWaitForever);
            for (int i = 0; i < 4; ++i) g_state.motorCmd[i] = stop[i];
            osMutexRelease(g_state.motMtx);
            if (Simulation::SimInterface::isSimulation())
                Simulation::SimInterface::exportMotors(stop);
            else if (g_dshotReady)
                Drivers::DShot::sendMotors(stop);
            g_state.ctrlLoopUs = dwt_us() - t0;
            continue;
        }
        /* 2. Mahony pre-computes a low-latency attitude from every IMU
         * sample. InvEKF consumes its attitude increment while estimating
         * the full navigation and calibration state. */
        static uint8_t ekfDecim = 0;
        Quaternionf att;
        Vector3f mahonyBias;
        osMutexAcquire(g_state.ahMtx, osWaitForever);
        g_mahony.updateIMU(gyro, accel, dt);
        att = g_mahony.getAttitude();
        mahonyBias = g_mahony.getGyroBias();
        osMutexRelease(g_state.ahMtx);

        bool predicted = false;
        Vector3f ekfGyroBias;
        osMutexAcquire(g_state.navMtx, osWaitForever);
        g_inekf.accumulateIMU(accel, gyro, att, dt);
        if (++ekfDecim >= 8) {
            ekfDecim = 0;
            g_inekf.predict(dt * 8.f);
            g_state.position_ned = g_inekf.getPosition();
            g_state.velocity_ned = g_inekf.getVelocity();
            ekfGyroBias = g_inekf.getGyroBias();
            predicted = true;
        }
        osMutexRelease(g_state.navMtx);

        if (predicted) {
            osMutexAcquire(g_state.ahMtx, osWaitForever);
            g_mahony.setGyroBias(ekfGyroBias);
            mahonyBias = g_mahony.getGyroBias();
            osMutexRelease(g_state.ahMtx);
        }
        osMutexAcquire(g_state.imuMtx, osWaitForever);
        g_state.imuReadError = false;
        g_state.gyro_raw_rps = gyro;
        g_state.gyro_rps = gyro - mahonyBias;
        g_state.accel_mps2 = accel;
        osMutexRelease(g_state.imuMtx);
        osMutexAcquire(g_state.ahMtx, osWaitForever);
        g_state.attitude  = att;
        g_state.euler_deg = att.toEulerRPY() * (180.f / 3.14159265f);
        osMutexRelease(g_state.ahMtx);

        /* 4. Flight mode FSM → control → motor commands */
        g_fsm.update(dt, g_inekf);

        /* 5. Send motor commands via DSHOT */
        osMutexAcquire(g_state.motMtx, osWaitForever);
        uint16_t cmds[4];
        for(int i=0;i<4;i++) cmds[i]=g_state.motorCmd[i];
        osMutexRelease(g_state.motMtx);
        if (Simulation::SimInterface::isSimulation())
            Simulation::SimInterface::exportMotors(cmds);
        else if (g_dshotReady)
            Drivers::DShot::sendMotors(cmds);

        g_state.ctrlLoopUs = dwt_us() - t0;
    }
}

/* ============================================================
 *  CRSF TASK (~500 Hz poll)
 * ============================================================ */
static void CRSFTask(void* /*arg*/) {
    for (;;) {
        osDelay(1); /* tick1ms() uses milliseconds; 2 ms doubled its timeout */
        bool fpv = (g_state.mode == FlightMode::FPV);
        g_crsf.processFrame(fpv);
        g_crsf.tick1ms();
    }
}

/* ============================================================
 *  BARO TASK (50 Hz)
 * ============================================================ */
static void BaroTask(void* /*arg*/) {
    osDelay(500);
    uint32_t lastGeneration = 0;
    for (;;) {
        osDelay(20);
        /* Driver work left: read MS5611 on SPI1 and publish altitude relative
         * to the navigation origin. This consumes any valid hardware/HIL feed. */
        osMutexAcquire(g_state.baroMtx, osWaitForever);
        const bool valid = g_state.baroValid;
        const uint32_t generation = g_state.baroGeneration;
        const float altitude = g_state.baro_alt_m;
        osMutexRelease(g_state.baroMtx);
        if (valid && generation != lastGeneration) {
            lastGeneration = generation;
            osMutexAcquire(g_state.navMtx, osWaitForever);
            g_inekf.updateBaro(altitude, 0.5f);
            g_state.position_ned = g_inekf.getPosition();
            g_state.velocity_ned = g_inekf.getVelocity();
            osMutexRelease(g_state.navMtx);
            syncMahonyGyroBiasFromInvEKF();
        }
    }
}

/* ============================================================
 *  MAG TASK (100 Hz)
 * ============================================================ */
static void MagTask(void* /*arg*/) {
    osDelay(200);
    uint32_t lastGeneration = 0;
    for (;;) {
        osDelay(10);
        /* Driver/calibration work left: read QMC5883L on I2C1, scale/soft-iron
         * calibrate it, and provide the local NED reference vector. */
        osMutexAcquire(g_state.magMtx, osWaitForever);
        const bool valid = g_state.magValid;
        const uint32_t generation = g_state.magGeneration;
        const Vector3f magBody = g_state.mag_body_uT;
        const Vector3f magNed = g_state.mag_reference_ned_uT;
        osMutexRelease(g_state.magMtx);
        if (valid && generation != lastGeneration) {
            lastGeneration = generation;
            osMutexAcquire(g_state.ahMtx, osWaitForever);
            if (magNed.norm() > 1.0e-3f) g_mahony.setMagReference(magNed);
            g_mahony.updateMag(magBody);
            osMutexRelease(g_state.ahMtx);
            osMutexAcquire(g_state.navMtx, osWaitForever);
            g_inekf.updateMag(magBody, magNed);
            osMutexRelease(g_state.navMtx);
            syncMahonyGyroBiasFromInvEKF();
        }
    }
}

/* ============================================================
 *  GPS TASK (10 Hz)
 * ============================================================ */
static void GPSTask(void* /*arg*/) {
    uint32_t lastSimGeneration = 0;
    uint32_t lastFixTick = 0;
    bool haveFix = false;
    bool latestFixValid = false;
    const auto setGpsError = [](bool fault) {
        osMutexAcquire(g_state.safetyMtx, osWaitForever);
        if (fault) g_state.errorFlags |= FC_ERR_GPS;
        else g_state.errorFlags &= ~FC_ERR_GPS;
        osMutexRelease(g_state.safetyMtx);
    };
    for (;;) {
        if (Simulation::SimInterface::isSimulation()) {
            osMutexAcquire(g_state.gpsMtx, osWaitForever);
            const bool valid = g_state.gps.fixValid;
            const uint32_t generation = g_state.gpsGeneration;
            const Vector3f simPos = g_state.sim_position_ned;
            const Vector3f simVel = g_state.sim_velocity_ned;
            osMutexRelease(g_state.gpsMtx);
            if (valid && generation != lastSimGeneration) {
                lastSimGeneration = generation;
                latestFixValid = true;
                haveFix = true;
                lastFixTick = osKernelGetTickCount();
                osMutexAcquire(g_state.navMtx, osWaitForever);
                g_inekf.updateGPS(simPos, simVel, 0.1f, 0.15f, 0.05f, 1.0f, 12);
                g_state.position_ned = g_inekf.getPosition();
                g_state.velocity_ned = g_inekf.getVelocity();
                osMutexRelease(g_state.navMtx);
                syncMahonyGyroBiasFromInvEKF();
            }
            const uint32_t now = osKernelGetTickCount();
            const bool stale = !haveFix || !latestFixValid ||
                static_cast<uint32_t>(now-lastFixTick) > 500u;
            if (stale) {
                osMutexAcquire(g_state.gpsMtx, osWaitForever);
                g_state.gps.fixValid = false;
                osMutexRelease(g_state.gpsMtx);
            }
            setGpsError(stale);
            osDelay(10);
            continue;
        }
        uint8_t byte;
        Communication::UBXParser::NavPvt fix;
        while (gpsRxPop(byte)) {
            if (!g_ubx.feed(byte, fix)) continue;

            GPSData gps;
            gps.lat_deg = fix.latitude_deg; gps.lon_deg = fix.longitude_deg;
            gps.alt_msl_m = fix.altitude_msl_m;
            gps.vel_n_mps = fix.velocity_n_mps;
            gps.vel_e_mps = fix.velocity_e_mps;
            gps.vel_d_mps = fix.velocity_d_mps;
            gps.hAcc_m = fix.horizontal_accuracy_m;
            gps.vAcc_m = fix.vertical_accuracy_m;
            gps.sAcc_mps = fix.speed_accuracy_mps;
            gps.positionDop = fix.position_dop;
            gps.numSats = fix.satellites;
            gps.fixValid = fix.fix_valid &&
                           g_inekf.gpsQualityAcceptable(gps.positionDop, gps.numSats);
            gps.lastUpdateMs = osKernelGetTickCount();
            latestFixValid = gps.fixValid;
            if (latestFixValid) {
                haveFix = true;
                lastFixTick = gps.lastUpdateMs;
            }

            NavOrigin origin = {};
            osMutexAcquire(g_state.gpsMtx, osWaitForever);
            g_state.gps = gps;
            ++g_state.gpsGeneration;
            if (!g_state.origin.set && gps.fixValid) {
                g_state.origin = {gps.lat_deg, gps.lon_deg, gps.alt_msl_m, true};
            }
            origin = g_state.origin;
            osMutexRelease(g_state.gpsMtx);

            if (gps.fixValid && origin.set) {
                constexpr double kEarthRadiusM = 6378137.0;
                constexpr double kDegToRad = 0.017453292519943295;
                const double lat0 = origin.lat_deg * kDegToRad;
                Vector3f pos_ned(
                    static_cast<float>((gps.lat_deg-origin.lat_deg)*kDegToRad*kEarthRadiusM),
                    static_cast<float>((gps.lon_deg-origin.lon_deg)*kDegToRad*kEarthRadiusM*std::cos(lat0)),
                    origin.alt_m-gps.alt_msl_m);
                Vector3f vel_ned(gps.vel_n_mps, gps.vel_e_mps, gps.vel_d_mps);
                osMutexAcquire(g_state.navMtx, osWaitForever);
                g_inekf.updateGPS(pos_ned, vel_ned, gps.hAcc_m, gps.vAcc_m,
                                  gps.sAcc_mps, gps.positionDop, gps.numSats);
                g_state.position_ned = g_inekf.getPosition();
                g_state.velocity_ned = g_inekf.getVelocity();
                osMutexRelease(g_state.navMtx);
                syncMahonyGyroBiasFromInvEKF();
                setGpsError(false);
            } else {
                setGpsError(true);
            }
        }
        const uint32_t now = osKernelGetTickCount();
        const bool stale = !haveFix || !latestFixValid ||
            static_cast<uint32_t>(now-lastFixTick) > 500u;
        if (stale) {
            osMutexAcquire(g_state.gpsMtx, osWaitForever);
            g_state.gps.fixValid = false;
            osMutexRelease(g_state.gpsMtx);
        }
        setGpsError(stale);
        osDelay(10);
    }
}

/* ============================================================
 *  MAVLINK TASK (10 Hz)
 *
 *  BUG FIX #6: Original code shared mavTxMutex with debug UART
 *  in safety.c. Now MAVLink goes through USB CDC.
 *  CDC_Transmit_FS() is thread-safe (uses its own internal lock).
 *  No shared mutex needed.
 *
 *  BUG FIX #7 (tangential): SD was opened/closed per log write.
 *  LoggerTask below keeps the file open; MAVLink is separate.
 * ============================================================ */
static void MAVLinkTask(void* /*arg*/) {
    for (;;) {
        osDelay(100);   /* 10 Hz base rate */
        /* TODO: Build MAVLink frames (HEARTBEAT, ATTITUDE, GPS_RAW,
         *       BATTERY_STATUS, MOTOR_OUTPUTS) and call:
         *       CDC_Transmit_FS(buf, len);
         *       Return value: USBD_OK if sent, USBD_BUSY if previous
         *       packet not yet consumed — retry next tick.            */
    }
}

/* ============================================================
 *  LOGGER TASK (queue-driven)
 *
 *  BUG FIX #7: SD card is opened ONCE at startup (here).
 *  Writes go to a FatFS buffer. f_sync() is called every
 *  LOG_SD_FLUSH_MS to commit to flash.
 *  The original code called f_open()/f_close() on every entry,
 *  blocking the task for ~100 ms per write.
 * ============================================================ */
static void LoggerTask(void* /*arg*/) {
    /* TODO: f_open() the log file here once.
     * Loop: drain log queue → f_write() → f_sync() every 500 ms.  */
    osDelay(2000);
    for (;;) {
        osDelay(20);
        /* TODO: Drain queue, write, flush */
    }
}

/* ============================================================
 *  SAFETY TASK (100 Hz, highest non-control priority)
 * ============================================================ */
static void SafetyTaskEntry(void* arg) {
    Safety::SafetyMonitor::taskEntry(arg);
}

/* ============================================================
 *  SYSTEM INIT — call from main() before osKernelStart()
 *
 *  BUG FIX #5: Original System_Init was truncated mid-function.
 *  All RTOS primitives, sensor init, and task creation happens here.
 * ============================================================ */
extern "C" void FC_SystemInit(void) {
    dwt_init();

    /* Shared state: creates all mutexes and semaphores */
    g_state.init();

    /* IMU */
    if (!Simulation::SimInterface::isSimulation() && !g_imu.init(&hspi1)) {
        g_state.errorFlags |= FC_ERR_IMU;
        HAL_GPIO_WritePin(ERROR_LED_PORT, ERROR_LED_PIN, GPIO_PIN_SET);
    }

    /* DSHOT — motor UART handles
     * BUG FIX #PINS: huart7 removed; correct array is:
     *   [0]=huart4(PA0), [1]=huart5(PC12), [2]=huart3(PB10), [3]=huart6(PC6) */
    UART_HandleTypeDef* motorUarts[4] = { &huart4, &huart5, &huart3, &huart6 };
    g_dshotReady = !Simulation::SimInterface::isSimulation() &&
                   Drivers::DShot::init(motorUarts);
    if (!g_dshotReady && !Simulation::SimInterface::isSimulation()) {
        osMutexAcquire(g_state.safetyMtx, osWaitForever);
        g_state.errorFlags |= FC_ERR_MOTOR_LOSS;
        osMutexRelease(g_state.safetyMtx);
    }

    /* CRSF RX interrupt on USART2 */
    __HAL_UART_ENABLE_IT(&huart2, UART_IT_RXNE);

    /* GPS UBX NAV-PVT byte stream into the bounded ISR/task ring. */
    HAL_NVIC_SetPriority(USART1_IRQn, 6, 0);
    HAL_NVIC_EnableIRQ(USART1_IRQn);
    if (!Simulation::SimInterface::isSimulation() &&
        HAL_UART_Receive_IT(&huart1, &g_gpsRxByte, 1) != HAL_OK) {
        osMutexAcquire(g_state.safetyMtx, osWaitForever);
        g_state.errorFlags |= FC_ERR_GPS;
        osMutexRelease(g_state.safetyMtx);
    }

    /* IMU DRDY on EXTI4 (PC4, pin 24) */
    if (!Simulation::SimInterface::isSimulation()) {
        HAL_NVIC_SetPriority(IMU_DRDY_IRQn, 5, 0);
        HAL_NVIC_EnableIRQ(IMU_DRDY_IRQn);
    }

    /* ---- Create RTOS tasks --------------------------------- */
    const osThreadAttr_t ctrlAttr  = {"CtrlLoop",0,nullptr,0,nullptr,STACK_CTRL_LOOP*4,nullptr,osPriorityRealtime,0};
    const osThreadAttr_t safeAttr  = {"Safety",  0,nullptr,0,nullptr,STACK_SAFETY*4,   nullptr,osPriorityHigh,0};
    const osThreadAttr_t crsfAttr  = {"CRSF",    0,nullptr,0,nullptr,STACK_CRSF*4,     nullptr,osPriorityAboveNormal,0};
    const osThreadAttr_t baroAttr  = {"Baro",    0,nullptr,0,nullptr,STACK_BARO*4,     nullptr,osPriorityNormal,0};
    const osThreadAttr_t magAttr   = {"Mag",     0,nullptr,0,nullptr,STACK_MAG*4,      nullptr,osPriorityNormal,0};
    const osThreadAttr_t gpsAttr   = {"GPS",     0,nullptr,0,nullptr,STACK_GPS*4,      nullptr,osPriorityNormal,0};
    const osThreadAttr_t mavAttr   = {"MAVLink", 0,nullptr,0,nullptr,STACK_MAVLINK*4,  nullptr,osPriorityLow,0};
    const osThreadAttr_t logAttr   = {"Logger",  0,nullptr,0,nullptr,STACK_LOGGER*4,   nullptr,osPriorityIdle,0};

    osThreadNew(ControlLoopTask,  nullptr,   &ctrlAttr);
    osThreadNew(SafetyTaskEntry,  &g_safety, &safeAttr);
    osThreadNew(CRSFTask,         nullptr,   &crsfAttr);
    osThreadNew(BaroTask,         nullptr,   &baroAttr);
    osThreadNew(MagTask,          nullptr,   &magAttr);
    osThreadNew(GPSTask,          nullptr,   &gpsAttr);
    osThreadNew(MAVLinkTask,      nullptr,   &mavAttr);
    osThreadNew(LoggerTask,       nullptr,   &logAttr);
}

} // FC
</file>

<file path="drone_fc/src/drivers/lsm6dsv.cpp">
#include "lsm6dsv.hpp"
#include "stm32f7xx_hal.h"
#include "../../Inc/fc_config.h"
#include <cstring>

namespace FC { namespace Drivers {

void LSM6DSV::csLow() {HAL_GPIO_WritePin(IMU_CS_PORT,IMU_CS_PIN,GPIO_PIN_RESET);}
void LSM6DSV::csHigh(){HAL_GPIO_WritePin(IMU_CS_PORT,IMU_CS_PIN,GPIO_PIN_SET);}

bool LSM6DSV::writeReg(uint8_t reg,uint8_t val){
    if (!hspi_) return false;
    uint8_t tx[2]={uint8_t(reg&0x7Fu),val}; csLow();
    const HAL_StatusTypeDef status = HAL_SPI_Transmit(hspi_,tx,2,2);
    csHigh();
    return status == HAL_OK;
}
bool LSM6DSV::readReg(uint8_t reg,uint8_t& value){
    if (!hspi_) return false;
    uint8_t tx[2]={uint8_t(reg|SPI_READ),0},rx[2]={}; csLow();
    const HAL_StatusTypeDef status = HAL_SPI_TransmitReceive(hspi_,tx,rx,2,2);
    csHigh();
    if (status != HAL_OK) return false;
    value = rx[1];
    return true;
}
bool LSM6DSV::readBurst(uint8_t reg,uint8_t* buf,uint8_t len){
    if (!hspi_ || !buf || len == 0u || len > 13u) return false;
    uint8_t tx[14]={}; tx[0]=reg|SPI_READ;
    uint8_t rx[14]={}; csLow();
    const HAL_StatusTypeDef status = HAL_SPI_TransmitReceive(hspi_,tx,rx,len+1u,2);
    csHigh();
    if (status != HAL_OK) return false;
    memcpy(buf,&rx[1],len);
    return true;
}

bool LSM6DSV::init(SPI_HandleTypeDef* hspi){
    hspi_=hspi; init_=false;
    if (!hspi_) return false;
    csHigh(); HAL_Delay(10);
    uint8_t whoAmI = 0u;
    if (!readReg(REG_WHO_AM_I,whoAmI) || whoAmI != WHO_AM_I_VAL) return false;
    if (!writeReg(REG_CTRL3_C,0x01u)) return false;
    HAL_Delay(1); /* SW reset */
    if (!writeReg(REG_CTRL3_C,(1u<<6)|(1u<<2))) return false; /* BDU, IF_INC */
    if (!writeReg(REG_CTRL1_XL,(IMU_ACCEL_ODR_CODE<<4)|(IMU_ACCEL_FS_CODE<<2))) return false;
    if (!writeReg(REG_CTRL2_G, (IMU_GYRO_ODR_CODE<<4)|IMU_GYRO_FS_CODE)) return false;
    if (!writeReg(REG_CTRL6_C, (IMU_GYRO_LPF_CODE<<2))) return false;
    if (!writeReg(REG_INT1_CTRL,0x02u)) return false; /* DRDY_G -> INT1 */
    HAL_Delay(1); init_=true; return true;
}

bool LSM6DSV::readRaw(Vector3f& gyro_rps,Vector3f& accel_mps2){
    if(!init_) return false;
    uint8_t buf[12];
    if (!readBurst(REG_OUTX_L_G,buf,12)) return false;
    auto s16=[&](int i){return(int16_t)((uint16_t)buf[i+1]<<8|buf[i]);};
    float gr[3]={(float)s16(0),(float)s16(2),(float)s16(4)};
    float ar[3]={(float)s16(6),(float)s16(8),(float)s16(10)};
    gyro_rps  ={kSign[0]*gr[kMap[0]]*kGyroScale  -gyroBias_.x,
                kSign[1]*gr[kMap[1]]*kGyroScale  -gyroBias_.y,
                kSign[2]*gr[kMap[2]]*kGyroScale  -gyroBias_.z};
    accel_mps2={kSign[0]*ar[kMap[0]]*kAccelScale,
                kSign[1]*ar[kMap[1]]*kAccelScale,
                kSign[2]*ar[kMap[2]]*kAccelScale};
    return true;
}
bool LSM6DSV::selfTest(){
    uint8_t whoAmI = 0u;
    return readReg(REG_WHO_AM_I,whoAmI) && whoAmI == WHO_AM_I_VAL;
}

}} // FC::Drivers
</file>

<file path="drone_fc/src/drivers/lsm6dsv.hpp">
#pragma once
#include <stdint.h>
#include "../math/vector3.hpp"
struct SPI_HandleTypeDef;

namespace FC { namespace Drivers {
using Math::Vector3f;

/** LSM6DSV320XTR IMU driver — SPI1, DRDY on PC4 (EXTI4).
 *
 * BUG FIX #9: Original code had no IMU driver. ax, gx, etc. were
 * uninitialised globals read directly. This provides a complete SPI burst
 * read driver with correct register map for the LSM6DSV320XTR. */
class LSM6DSV {
public:
    static constexpr uint8_t WHO_AM_I_VAL=0x70u;
    static constexpr uint8_t REG_WHO_AM_I=0x0Fu;
    static constexpr uint8_t REG_CTRL1_XL=0x10u;
    static constexpr uint8_t REG_CTRL2_G =0x11u;
    static constexpr uint8_t REG_CTRL3_C =0x12u;
    static constexpr uint8_t REG_CTRL6_C =0x15u;
    static constexpr uint8_t REG_INT1_CTRL=0x0Du;
    static constexpr uint8_t REG_OUTX_L_G =0x22u;
    static constexpr uint8_t REG_OUTX_L_XL=0x28u;
    static constexpr uint8_t SPI_READ=0x80u;

    bool init(SPI_HandleTypeDef* hspi);
    bool readRaw(Vector3f& gyro_rps, Vector3f& accel_mps2);
    bool selfTest();
    void setGyroBias(const Vector3f& b){gyroBias_=b;}
    Vector3f getGyroBias()const{return gyroBias_;}
    bool isInitialised()const{return init_;}

private:
    SPI_HandleTypeDef* hspi_=nullptr;
    Vector3f gyroBias_={0,0,0};
    bool init_=false;
    /* Axis remap: identity (chip Z=down=FRD Z). Adjust if PCB mounted differently. */
    static constexpr int   kMap[3]={0,1,2};
    static constexpr float kSign[3]={1,1,1};
    /* Scale: gyro 70 mdps/LSB -> rad/s; accel 0.488 mg/LSB -> m/s² */
    static constexpr float kGyroScale =0.0700f*(3.14159265f/180.f);
    static constexpr float kAccelScale=0.000488f*9.80665f;
    void csLow(); void csHigh();
    bool writeReg(uint8_t reg,uint8_t val);
    bool readReg(uint8_t reg,uint8_t& value);
    bool readBurst(uint8_t reg,uint8_t* buf,uint8_t len);
};

}} // FC::Drivers
</file>

<file path="drone_fc/src/drivers/startup_calibration.hpp">
#pragma once
#include "lsm6dsv.hpp"
#include "../../Inc/fc_config.h"
#include "stm32f7xx_hal.h"

namespace FC { namespace Drivers {

/** Pre-arm gyro bias calibration. Collect N stationary IMU samples,
 *  compute mean, store in driver. Call before RTOS scheduler starts. */
class StartupCalibration {
public:
    static constexpr int   kNumSamples=2000; /* ~0.52 s at 3840 Hz */
    static constexpr float kMaxGyroMag=0.30f;
    static constexpr float kMinAccelMag=9.30f, kMaxAccelMag=10.30f;
    static constexpr uint32_t kTimeoutMs=3000u;
    static constexpr uint32_t kMaxDrdyPolls=1000000u;

    static bool run(LSM6DSV& imu, uint32_t timeoutMs=kTimeoutMs){
        if (timeoutMs == 0u) return false;
        Math::Vector3f accum={0,0,0}; int valid=0;
        const uint32_t startTick=HAL_GetTick();
        for(int i=0;i<kNumSamples;i++){
            if(static_cast<uint32_t>(HAL_GetTick()-startTick)>=timeoutMs)
                return false;
            uint32_t polls=0u;
            while(!HAL_GPIO_ReadPin(IMU_DRDY_PORT,IMU_DRDY_PIN)){
                if(static_cast<uint32_t>(HAL_GetTick()-startTick)>=timeoutMs ||
                   ++polls>=kMaxDrdyPolls)
                    return false;
            }
            Math::Vector3f g,a;
            if(!imu.readRaw(g,a)) continue;
            if(g.norm()>kMaxGyroMag) continue;
            float am=a.norm();
            if(am<kMinAccelMag||am>kMaxAccelMag) continue;
            accum+=g; valid++;
        }
        if(static_cast<uint32_t>(HAL_GetTick()-startTick)>=timeoutMs ||
           valid<kNumSamples/2) return false;
        imu.setGyroBias(accum*(1.f/(float)valid));
        return true;
    }
};

}} // FC::Drivers
</file>

<file path="drone_fc/src/flight_modes/flight_mode_fsm.cpp">
#include "flight_mode_fsm.hpp"
#include "../../Inc/fc_config.h"
#include "cmsis_os.h"
#include <cmath>

namespace FC { namespace FlightModes {

FlightModeFSM::FlightModeFSM()
    : rateCtrl_(RateController::fpvPreset()),
      attCtrl_(AttitudeController::cameraGains()),
      posCtrl_(PositionController::cameraGains()),
      velCtrl_(VelocityController::cameraGains()),
      mixer_(Mixer::fpvConfig())
{}

/* ============================================================
 *  Main update — IMU rate (~3840 Hz)
 * ============================================================ */
void FlightModeFSM::update(float dt, InvEKF& ekf) {

    /* Read shared state atomically */
    RCInputs rc;
    osMutexAcquire(g_state.rcMtx, osWaitForever);
    rc = g_state.rc;
    osMutexRelease(g_state.rcMtx);

    osMutexAcquire(g_state.imuMtx, osWaitForever);
    Vector3f gyro  = g_state.gyro_rps;
    osMutexRelease(g_state.imuMtx);

    osMutexAcquire(g_state.ahMtx, osWaitForever);
    Quaternionf attitude = g_state.attitude;
    osMutexRelease(g_state.ahMtx);

    osMutexAcquire(g_state.navMtx, osWaitForever);
    Vector3f vel_ned = g_state.velocity_ned;
    osMutexRelease(g_state.navMtx);

    osMutexAcquire(g_state.safetyMtx, osWaitForever);
    bool killMotors = g_state.killMotors;
    osMutexRelease(g_state.safetyMtx);

    /* SafetyMonitor may enter FAILSAFE asynchronously (for battery/fence
     * faults). Initialise the autonomous descent on the transition itself. */
    if (g_state.mode == FlightMode::FAILSAFE && prevMode_ != FlightMode::FAILSAFE) {
        rateCtrl_.setPreset(RateController::cameraPreset());
        mixer_.setConfig(Mixer::cameraConfig());
        mixer_.enableMotors(true);
        attCtrl_.captureYaw(attitude.toEulerRPY().z);
        velCtrl_.reset();
        posCtrl_.reset();
        positionHoldActive_ = false;
        desiredRoll_rad_ = desiredPitch_rad_ = velThrustDelta_ = 0.0f;
        fsDescentRate_ = 0.0f;
        velSetpoint_ned_ = {0.0f, 0.0f, 0.0f};
    }

    /* GPS position hold is a 50 Hz outer loop. Run it before the 100 Hz
     * velocity loop so a coincident tick consumes the newest setpoint. */
    if (g_state.mode == FlightMode::CAMERA && ++posDecim_ >= kPosDecim) {
        posDecim_ = 0;
        updatePositionLoop(static_cast<float>(kPosDecim) / CTRL_LOOP_HZ, ekf);
    }

    /* Hard kill overrides everything */
    if (killMotors) {
        uint16_t z[4]={0,0,0,0};
        osMutexAcquire(g_state.motMtx, osWaitForever);
        for(int i=0;i<4;i++) g_state.motorCmd[i]=z[i];
        osMutexRelease(g_state.motMtx);
        g_state.mode=FlightMode::DISARMED;
        g_state.armState=ArmState::DISARMED;
        return;
    }

    /* ---- Velocity controller update (100 Hz) ----------------
     *
     * Runs every kVelDecim ticks.  Updates desiredRoll_rad_ and
     * desiredPitch_rad_ which are then used by the attitude
     * controller every tick at 3840 Hz.
     *
     * In camera mode the velocity setpoint comes from:
     *   - RC sticks (mapped to heading-relative velocity) if no GPS hold
     *   - posCtrl_ output (updated at 50 Hz) if GPS hold is active
     *
     * In FPV mode this block is skipped entirely.
     * --------------------------------------------------------- */
    if (g_state.mode == FlightMode::CAMERA ||
        g_state.mode == FlightMode::FAILSAFE) {

        if (++velDecim_ >= kVelDecim) {
            velDecim_ = 0;
            float dt_vel = static_cast<float>(kVelDecim) / CTRL_LOOP_HZ;

            Vector3f euler = attitude.toEulerRPY();
            float yaw = euler.z;

            osMutexAcquire(g_state.gpsMtx, osWaitForever);
            const bool gpsFixValid = g_state.gps.fixValid;
            osMutexRelease(g_state.gpsMtx);
            if (g_state.mode == FlightMode::FAILSAFE) {
                fsDescentRate_ = std::fmin(0.8f, fsDescentRate_ + kFsDescentRps * dt_vel);
                velSetpoint_ned_ = {0.f, 0.f, fsDescentRate_};
            } else if (!rc.altHold || !gpsFixValid) {
                /* No GPS hold: map sticks to NED velocity setpoint */
                velSetpoint_ned_ = VelocityController::sticksToVelSetpoint(
                    rc.pitch, rc.roll, yaw, CAM_MAX_VEL_HORIZ);
                /* Vertical: throttle stick → vertical velocity */
                velSetpoint_ned_.z = -(rc.throttle * 2.f - 1.f) * CAM_MAX_VEL_VERT;
            }
            /* else: velSetpoint_ned_ was set by updatePositionLoop() */

            auto out = velCtrl_.update(velSetpoint_ned_, vel_ned, yaw, dt_vel);
            desiredRoll_rad_  = out.roll_rad;
            desiredPitch_rad_ = out.pitch_rad;
            velThrustDelta_   = out.thrust_delta;
        }
    }

    /* ---- Main FSM ------------------------------------------ */
    switch (g_state.mode) {

    case FlightMode::DISARMED:
        { uint16_t k[4]={0,0,0,0};
          osMutexAcquire(g_state.motMtx, osWaitForever);
          for(int i=0;i<4;i++) g_state.motorCmd[i]=k[i];
          osMutexRelease(g_state.motMtx);
          mixer_.enableMotors(false); }
        tryArm();
        break;

    case FlightMode::ARMED:
        { uint16_t id[4];
          mixer_.idle(id);
          osMutexAcquire(g_state.motMtx, osWaitForever);
          for(int i=0;i<4;i++) g_state.motorCmd[i]=id[i];
          osMutexRelease(g_state.motMtx); }
        if (rc.valid && rc.throttle > 0.05f) {
            if (rc.modeSwitch) enterCamera(); else enterFPV();
        }
        tryDisarm();
        break;

    case FlightMode::FPV:
        if (!rc.valid)       { handleFailsafe(); break; }
        if (!rc.armSwitch)   { tryDisarm();      break; }
        if (rc.modeSwitch)   { enterCamera();    break; }
        runFPV(dt, gyro);
        break;

    case FlightMode::CAMERA:
        if (!rc.valid)       { handleFailsafe(); break; }
        if (!rc.armSwitch)   { tryDisarm();      break; }
        if (!rc.modeSwitch)  { enterFPV();       break; }
        runCamera(dt, gyro, attitude, vel_ned);
        break;

    case FlightMode::FAILSAFE:
        /* Velocity controller already updated above.
         * Run camera-style control for a gentle descent.            */
        runCamera(dt, gyro, attitude, vel_ned);
        { osMutexAcquire(g_state.navMtx, osWaitForever);
          float vd = g_state.velocity_ned.z;
          osMutexRelease(g_state.navMtx);
          osMutexAcquire(g_state.baroMtx, osWaitForever);
          const bool landed = g_state.baroValid && g_state.baro_alt_agl_m < 0.3f &&
                              std::fabs(vd) < 0.15f;
          osMutexRelease(g_state.baroMtx);
          if (landed) enterLanding(); }
        break;

    case FlightMode::LANDING:
        landingThrottle_ -= 0.2f * dt;
        if (landingThrottle_ < 0.f) {
            landingThrottle_ = 0.f;
            g_state.mode     = FlightMode::DISARMED;
            g_state.armState = ArmState::DISARMED;
            mixer_.enableMotors(false);
        } else {
            Vector3f torque = rateCtrl_.update({0,0,0}, gyro, dt);
            uint16_t cmds[4]; mixer_.mix(landingThrottle_, torque, cmds);
            osMutexAcquire(g_state.motMtx, osWaitForever);
            for(int i=0;i<4;i++) g_state.motorCmd[i]=cmds[i];
            osMutexRelease(g_state.motMtx);
        }
        break;

    default: break;
    }

    prevMode_ = g_state.mode;
}

/* ============================================================
 *  FPV — rate loop only, all outer loops bypassed
 * ============================================================ */
void FlightModeFSM::runFPV(float dt, const Vector3f& gyro_rps) {
    RCInputs rc;
    osMutexAcquire(g_state.rcMtx, osWaitForever); rc=g_state.rc;
    osMutexRelease(g_state.rcMtx);

    Vector3f rateSp = rcToRateSetpointFPV(rc);
    Vector3f torque = rateCtrl_.update(rateSp, gyro_rps, dt);
    uint16_t cmds[4];
    mixer_.mix(rc.throttle, torque, cmds);
    osMutexAcquire(g_state.motMtx, osWaitForever);
    for(int i=0;i<4;i++) g_state.motorCmd[i]=cmds[i];
    osMutexRelease(g_state.motMtx);
    g_state.rateSetpoint_rps=rateSp; g_state.torqueOutput=torque;
    g_state.thrustOutput=rc.throttle;
}

/* ============================================================
 *  Camera — full cascade: vel → attitude → rate
 *
 *  The velocity controller already ran at 100 Hz and stored
 *  desiredRoll_rad_ / desiredPitch_rad_.  Here we just pass
 *  those stored tilt angles to the attitude controller which
 *  runs every tick at 3840 Hz for tight attitude tracking.
 * ============================================================ */
void FlightModeFSM::runCamera(float dt, const Vector3f& gyro_rps,
                               const Quaternionf& attitude,
                               const Vector3f& /*vel_ned*/)
{
    RCInputs rc;
    osMutexAcquire(g_state.rcMtx, osWaitForever); rc=g_state.rc;
    osMutexRelease(g_state.rcMtx);

    /* Yaw: from stick directly, integrated into desired heading */
    float maxYawRps = CAM_MAX_YAW_RATE * (3.14159265f / 180.f);
    float yawRateDem = g_state.mode == FlightMode::FAILSAFE ? 0.f : rc.yaw * maxYawRps;

    /* Build desired quaternion from the velocity-controller tilt.
     * desiredRoll_rad_ / desiredPitch_rad_ are body-frame tilt angles
     * output by the velocity controller at 100 Hz (held between updates).
     * The attitude controller converts these to a quaternion and then
     * runs the proportional quaternion-error law at 3840 Hz.             */
    Quaternionf qDes = attCtrl_.buildDesiredAttitude(
        desiredRoll_rad_  / (CAM_MAX_ROLL_ANGLE  * 3.14159265f / 180.f),
        desiredPitch_rad_ / (CAM_MAX_PITCH_ANGLE * 3.14159265f / 180.f),
        yawRateDem,
        CAM_MAX_ROLL_ANGLE  * (3.14159265f / 180.f),
        CAM_MAX_PITCH_ANGLE * (3.14159265f / 180.f),
        dt);

    Vector3f rateSp = attCtrl_.update(qDes, attitude);
    Vector3f torque = rateCtrl_.update(rateSp, gyro_rps, dt);

    /* Thrust: base from velCtrl vertical output + small hover offset */
    float thrust = 0.5f + velThrustDelta_;
    thrust = thrust > 1.f ? 1.f : (thrust < 0.f ? 0.f : thrust);

    uint16_t cmds[4];
    mixer_.mix(thrust, torque, cmds);
    osMutexAcquire(g_state.motMtx, osWaitForever);
    for(int i=0;i<4;i++) g_state.motorCmd[i]=cmds[i];
    osMutexRelease(g_state.motMtx);
    g_state.rateSetpoint_rps=rateSp; g_state.torqueOutput=torque;
    g_state.thrustOutput=thrust;
}

/* ============================================================
 *  Position loop at ~50 Hz
 *  Updates velSetpoint_ned_ from GPS position error.
 * ============================================================ */
void FlightModeFSM::updatePositionLoop(float dt, const InvEKF& ekf) {
    if (g_state.mode != FlightMode::CAMERA) return;

    RCInputs rc;
    osMutexAcquire(g_state.rcMtx, osWaitForever); rc=g_state.rc;
    osMutexRelease(g_state.rcMtx);
    osMutexAcquire(g_state.gpsMtx, osWaitForever);
    const bool gpsFixValid = g_state.gps.fixValid;
    osMutexRelease(g_state.gpsMtx);
    if (!rc.altHold || !gpsFixValid) {
        positionHoldActive_ = false;
        return;
    }

    osMutexAcquire(g_state.navMtx, osWaitForever);
    const Vector3f pos = ekf.getPosition();
    const Vector3f vel = ekf.getVelocity();
    osMutexRelease(g_state.navMtx);
    if (!positionHoldActive_) {
        posCtrl_.captureSetpoint(pos);
        positionHoldActive_ = true;
    }
    velSetpoint_ned_ = posCtrl_.update(pos, vel, dt);
}

/* ============================================================
 *  Arming
 * ============================================================ */
void FlightModeFSM::tryArm() {
    RCInputs rc;
    osMutexAcquire(g_state.rcMtx, osWaitForever); rc=g_state.rc;
    osMutexRelease(g_state.rcMtx);

    osMutexAcquire(g_state.safetyMtx, osWaitForever);
    bool noFault = !g_state.killMotors &&
                   !(g_state.errorFlags & (FC_ERR_IMU | FC_ERR_TILT_LIMIT |
                                           FC_ERR_MOTOR_LOSS));
    osMutexRelease(g_state.safetyMtx);

    osMutexAcquire(g_state.imuMtx, osWaitForever);
    float gm = g_state.gyro_rps.norm();
    osMutexRelease(g_state.imuMtx);

    if (rc.valid && rc.armSwitch && rc.throttle < 0.05f && noFault && gm < 0.10f) {
        const uint32_t now = osKernelGetTickCount();
        if (!armHoldActive_) {
            armHoldStartTick_ = now;
            armHoldActive_ = true;
        }
        const uint32_t elapsedMs = static_cast<uint32_t>(
            (static_cast<uint64_t>(now - armHoldStartTick_) * 1000u) /
            osKernelGetTickFreq());
        if (elapsedMs >= kArmHoldMs) {
            g_state.armState=ArmState::ARMED; g_state.mode=FlightMode::ARMED;
            mixer_.enableMotors(true);
            rateCtrl_.reset(); attCtrl_.reset();
            velCtrl_.reset();  posCtrl_.reset();
            armHoldActive_=false; modeEntryMs_=osKernelGetTickCount();
        }
    } else { armHoldActive_=false; }
}

void FlightModeFSM::tryDisarm() {
    RCInputs rc;
    osMutexAcquire(g_state.rcMtx, osWaitForever); rc=g_state.rc;
    osMutexRelease(g_state.rcMtx);
    if (!rc.armSwitch || !rc.valid) {
        g_state.mode=FlightMode::DISARMED; g_state.armState=ArmState::DISARMED;
        mixer_.enableMotors(false);
        rateCtrl_.reset(); attCtrl_.reset(); velCtrl_.reset(); posCtrl_.reset();
    }
}

void FlightModeFSM::enterFPV() {
    rateCtrl_.setPreset(RateController::fpvPreset());
    mixer_.setConfig(Mixer::fpvConfig()); mixer_.enableMotors(true);
    /* Reset outer loops — not needed in FPV but clean state for next switch */
    velCtrl_.reset(); attCtrl_.reset();
    g_state.mode=FlightMode::FPV; modeEntryMs_=osKernelGetTickCount();
}

void FlightModeFSM::enterCamera() {
    rateCtrl_.setPreset(RateController::cameraPreset());
    mixer_.setConfig(Mixer::cameraConfig()); mixer_.enableMotors(true);
    /* Capture heading so there is no yaw snap */
    osMutexAcquire(g_state.ahMtx, osWaitForever);
    Math::Vector3f euler=g_state.attitude.toEulerRPY();
    osMutexRelease(g_state.ahMtx);
    attCtrl_.captureYaw(euler.z);
    /* Initialise velocity setpoint from current velocity so there
     * is no jump in the velocity controller's error on mode entry   */
    osMutexAcquire(g_state.navMtx, osWaitForever);
    velSetpoint_ned_=g_state.velocity_ned;
    osMutexRelease(g_state.navMtx);
    velCtrl_.reset(); posCtrl_.reset(); positionHoldActive_=false;
    desiredRoll_rad_=0.f; desiredPitch_rad_=0.f; velThrustDelta_=0.f;
    g_state.mode=FlightMode::CAMERA; modeEntryMs_=osKernelGetTickCount();
}

void FlightModeFSM::enterLanding() {
    landingThrottle_=g_state.thrustOutput;
    g_state.mode=FlightMode::LANDING;
}

void FlightModeFSM::handleFailsafe() {
    rateCtrl_.setPreset(RateController::cameraPreset());
    mixer_.setConfig(Mixer::cameraConfig()); mixer_.enableMotors(true);
    osMutexAcquire(g_state.ahMtx, osWaitForever);
    const float yaw = g_state.attitude.toEulerRPY().z;
    osMutexRelease(g_state.ahMtx);
    attCtrl_.captureYaw(yaw);
    velCtrl_.reset(); posCtrl_.reset(); positionHoldActive_=false;
    desiredRoll_rad_=desiredPitch_rad_=velThrustDelta_=0.0f;
    /* Zero velocity setpoint: hover in place and descend slowly */
    velSetpoint_ned_={0.f,0.f, 0.f};
    g_state.mode=FlightMode::FAILSAFE; fsDescentRate_=0.f;
    osMutexAcquire(g_state.safetyMtx, osWaitForever);
    g_state.errorFlags|=FC_ERR_RC_LOSS;
    osMutexRelease(g_state.safetyMtx);
}

Vector3f FlightModeFSM::rcToRateSetpointFPV(const RCInputs& rc) {
    constexpr float d2r=3.14159265f/180.f;
    return { rc.roll*FPV_MAX_ROLL_RATE*d2r,
             rc.pitch*FPV_MAX_PITCH_RATE*d2r,
             rc.yaw*FPV_MAX_YAW_RATE*d2r };
}

}} // FC::FlightModes
</file>

<file path="drone_fc/src/flight_modes/flight_mode_fsm.hpp">
#pragma once
#include "../core/shared_state.hpp"
#include "../control/rate_controller.hpp"
#include "../control/attitude_controller.hpp"
#include "../control/position_controller.hpp"
#include "../control/velocity_controller.hpp"
#include "../actuation/mixer.hpp"
#include "../estimation/mahony_ahrs.hpp"
#include "../estimation/invariant_ekf.hpp"

namespace FC { namespace FlightModes {

using namespace Control;
using namespace Actuation;
using namespace Estimation;
using Math::Vector3f;
using Math::Quaternionf;

/**
 * @brief  Flight Mode State Machine
 *
 * FULL CAMERA-MODE CASCADE (all loops active):
 *
 *   GPS pos error [m]
 *       ↓  50 Hz  [PositionController]
 *   vel setpoint [m/s, NED]
 *       ↓  100 Hz [VelocityController]   ← NEW
 *   tilt demand [roll, pitch, rad]
 *       ↓  3840 Hz [AttitudeController]
 *   rate setpoint [rad/s]
 *       ↓  3840 Hz [RateController]
 *   torque [-1..+1]
 *       ↓  [Mixer]
 *   DSHOT[0..2047] × 4
 *
 * FPV MODE (all outer loops bypassed):
 *   RC sticks → rate setpoint → [RateController] → torque → [Mixer]
 *
 * CAMERA MODE (no GPS hold):
 *   RC sticks → vel setpoint → [VelocityController] → tilt
 *            → [AttitudeController] → rate setpoint → [RateController]
 *
 * CAMERA MODE (GPS hold active):
 *   pos error → [PositionController] → vel setpoint
 *            → [VelocityController] → tilt → [AttitudeController] → ...
 *
 * VELOCITY CONTROLLER DECIMATION:
 *   The control loop runs at ~3840 Hz (IMU-paced).
 *   The velocity controller runs at 100 Hz = every 38 IMU ticks.
 *   The last computed tilt from the velocity controller is held
 *   between its updates and used by the attitude controller every tick.
 *   This is correct because tilt changes are slow (<<100 Hz bandwidth).
 */
class FlightModeFSM {
public:
    FlightModeFSM();

    /**
     * @brief  Main update at IMU rate (~3840 Hz).
     * @param dt       True elapsed time since last call [s].
     * @param ekf      24-state invariant navigation filter.
     */
    void update(float dt, InvEKF& ekf);

    /**
     * @brief  Slower update at ~50 Hz for position loop.
     * @param dt   ~20 ms step.
     * @param ekf  24-state invariant navigation filter.
     */
    void updatePositionLoop(float dt, const InvEKF& ekf);

    FlightMode getMode()  const { return g_state.mode; }
    ArmState   getArm()   const { return g_state.armState; }

private:
    /* ---- Sub-controllers ----------------------------------- */
    RateController     rateCtrl_;
    AttitudeController attCtrl_;
    PositionController posCtrl_;
    VelocityController velCtrl_;
    Mixer              mixer_;

    /* ---- Velocity controller state ------------------------- */
    /* Held between 100 Hz velocity updates, used every 3840 Hz tick */
    float   desiredRoll_rad_  = 0.f;
    float   desiredPitch_rad_ = 0.f;
    float   velThrustDelta_   = 0.f;

    /* Velocity setpoint — updated by pos controller or RC sticks */
    Vector3f velSetpoint_ned_ = {0.f, 0.f, 0.f};

    /* Decimation counters */
    uint16_t velDecim_ = 0;
    uint16_t posDecim_ = 0;
    static constexpr uint16_t kVelDecim = 38;   /* 3840/100 ≈ 38 → ~101 Hz */
    static constexpr uint16_t kPosDecim = 77;   /* 3840/50  ≈ 77 → ~49.9 Hz */

    /* ---- Mode helpers -------------------------------------- */
    void tryArm();
    void tryDisarm();
    void handleFailsafe();
    void enterFPV();
    void enterCamera();
    void enterLanding();

    /* ---- Per-mode update routines -------------------------- */
    void runFPV   (float dt, const Vector3f& gyro_rps);
    void runCamera(float dt, const Vector3f& gyro_rps,
                             const Quaternionf& attitude,
                             const Vector3f& vel_ned);

    static Vector3f rcToRateSetpointFPV(const RCInputs& rc);

    /* ---- State --------------------------------------------- */
    FlightMode prevMode_    = FlightMode::DISARMED;
    uint32_t   modeEntryMs_ = 0;
    float      landingThrottle_ = 0.3f;
    uint32_t   armHoldStartTick_ = 0;
    bool       armHoldActive_ = false;
    float      fsDescentRate_ = 0.f;
    bool       positionHoldActive_ = false;

    static constexpr uint32_t kArmHoldMs = 500u;
    static constexpr float    kFsDescentRps = 0.5f;
};

}} // FC::FlightModes
</file>

<file path="drone_fc/src/math/quaternion.hpp">
#pragma once
#include "vector3.hpp"
#include <cmath>

namespace FC { namespace Math {

/**
 * Hamilton quaternion:  q = w + xi + yj + zk
 * Convention: q rotates body-frame FRD → world-frame NED.
 */
struct Quaternionf {
    float w, x, y, z;

    constexpr Quaternionf() : w(1.f), x(0.f), y(0.f), z(0.f) {}
    constexpr Quaternionf(float w_, float x_, float y_, float z_)
        : w(w_), x(x_), y(y_), z(z_) {}

    static Quaternionf identity() { return {1.f,0.f,0.f,0.f}; }
    Quaternionf conjugate() const { return {w,-x,-y,-z}; }
    float normSq() const { return w*w+x*x+y*y+z*z; }
    float norm()   const { return sqrtf(normSq()); }
    void normalise() {
        float inv=1.f/sqrtf(normSq()+1e-30f);
        w*=inv; x*=inv; y*=inv; z*=inv;
    }

    Quaternionf operator*(const Quaternionf& r) const {
        return { w*r.w-x*r.x-y*r.y-z*r.z,
                 w*r.x+x*r.w+y*r.z-z*r.y,
                 w*r.y-x*r.z+y*r.w+z*r.x,
                 w*r.z+x*r.y-y*r.x+z*r.w };
    }
    Quaternionf& operator*=(const Quaternionf& r) { *this=*this*r; return *this; }

    /** Optimised sandwich product: v' = q ⊗ [0,v] ⊗ q* */
    Vector3f rotate(const Vector3f& v) const {
        float tx=2.f*(y*v.z-z*v.y), ty=2.f*(z*v.x-x*v.z), tz=2.f*(x*v.y-y*v.x);
        return { v.x+w*tx+y*tz-z*ty,
                 v.y+w*ty+z*tx-x*tz,
                 v.z+w*tz+x*ty-y*tx };
    }
    Vector3f rotateInverse(const Vector3f& v) const { return conjugate().rotate(v); }

    /** Shortest-path attitude error:  q_err = q_desired ⊗ q_current⁻¹ */
    static Quaternionf attitudeError(const Quaternionf& des, const Quaternionf& cur) {
        Quaternionf e = des * cur.conjugate();
        if (e.w < 0.f) { e.w=-e.w; e.x=-e.x; e.y=-e.y; e.z=-e.z; }
        return e;
    }

    /* -------------------------------------------------------
     * Improvement #8: Exact exponential-map quaternion integration
     *
     *   q_{k+1} = q_k ⊗ exp(ω * dt / 2)
     *
     * For constant ω over dt this is the exact solution on SO(3).
     * Eliminates the first-order Euler truncation error.
     * At 3840 Hz the difference is tiny, but it removes drift
     * on the rotation manifold entirely.
     * ------------------------------------------------------- */
    void integrateBodyRate(const Vector3f& omega, float dt) {
        float halfAngle = omega.norm() * 0.5f * dt;
        Quaternionf dq;
        if (halfAngle > 1e-6f) {
            const float s = sinf(halfAngle) / (omega.norm() + 1e-30f);
            dq.w = cosf(halfAngle);
            dq.x = omega.x * s;
            dq.y = omega.y * s;
            dq.z = omega.z * s;
        } else {
            /* Small angle: first-order is indistinguishable from exact */
            dq.w = 1.f;
            dq.x = 0.5f * omega.x * dt;
            dq.y = 0.5f * omega.y * dt;
            dq.z = 0.5f * omega.z * dt;
        }
        *this = *this * dq;
        normalise();
    }

    /* -------------------------------------------------------
     * Improvement #4: Quaternion exponential map for error injection
     *
     *   exp(u) = [cos(|u|), û·sin(|u|)]
     *
     * Used by InvEKF to inject the attitude error state δθ into
     * the nominal quaternion without the small-angle approximation.
     * ------------------------------------------------------- */
    static Quaternionf expMap(const Vector3f& u) {
        float angle = u.norm();
        if (angle < 1e-8f) {
            /* First-order for near-zero rotation */
            Quaternionf q; q.w=1.f; q.x=u.x; q.y=u.y; q.z=u.z; q.normalise(); return q;
        }
        float s = sinf(angle) / angle;
        return { cosf(angle), u.x*s, u.y*s, u.z*s };
    }

    /** Euler ZYX extract – use only for telemetry/logging */
    Vector3f toEulerRPY() const {
        float sinr=2.f*(w*x+y*z), cosr=1.f-2.f*(x*x+y*y);
        float sinp=2.f*(w*y-z*x);
        sinp = sinp>1.f?1.f:(sinp<-1.f?-1.f:sinp);
        float siny=2.f*(w*z+x*y), cosy=1.f-2.f*(y*y+z*z);
        return { atan2f(sinr,cosr), asinf(sinp), atan2f(siny,cosy) };
    }

    static Quaternionf fromEulerRPY(float roll, float pitch, float yaw) {
        float hr=roll*.5f,hp=pitch*.5f,hy=yaw*.5f;
        float cr=cosf(hr),sr=sinf(hr),cp=cosf(hp),sp=sinf(hp),cy=cosf(hy),sy=sinf(hy);
        return { cr*cp*cy+sr*sp*sy, sr*cp*cy-cr*sp*sy, cr*sp*cy+sr*cp*sy, cr*cp*sy-sr*sp*cy };
    }

    static Quaternionf fromAxisAngle(const Vector3f& axis, float angle) {
        float ha=angle*.5f, s=sinf(ha);
        return { cosf(ha), axis.x*s, axis.y*s, axis.z*s };
    }

    static Quaternionf slerp(const Quaternionf& q0, const Quaternionf& q1, float t) {
        float dot=q0.w*q1.w+q0.x*q1.x+q0.y*q1.y+q0.z*q1.z;
        Quaternionf q1s=q1;
        if(dot<0.f){dot=-dot;q1s.w=-q1s.w;q1s.x=-q1s.x;q1s.y=-q1s.y;q1s.z=-q1s.z;}
        if(dot>0.9995f){
            Quaternionf r={q0.w+t*(q1s.w-q0.w),q0.x+t*(q1s.x-q0.x),
                           q0.y+t*(q1s.y-q0.y),q0.z+t*(q1s.z-q0.z)};
            r.normalise(); return r;
        }
        float th0=acosf(dot), th=th0*t, si0inv=1.f/sinf(th0);
        float s0=cosf(th)-dot*sinf(th)*si0inv, s1=sinf(th)*si0inv;
        return {s0*q0.w+s1*q1s.w,s0*q0.x+s1*q1s.x,s0*q0.y+s1*q1s.y,s0*q0.z+s1*q1s.z};
    }

    void toRotationMatrix(float R[3][3]) const {
        float xx=x*x,yy=y*y,zz=z*z,wx=w*x,wy=w*y,wz=w*z,xy=x*y,xz=x*z,yz=y*z;
        R[0][0]=1.f-2.f*(yy+zz); R[0][1]=2.f*(xy-wz);     R[0][2]=2.f*(xz+wy);
        R[1][0]=2.f*(xy+wz);     R[1][1]=1.f-2.f*(xx+zz); R[1][2]=2.f*(yz-wx);
        R[2][0]=2.f*(xz-wy);     R[2][1]=2.f*(yz+wx);     R[2][2]=1.f-2.f*(xx+yy);
    }
};

}} // FC::Math
</file>

<file path="drone_fc/src/math/vector3.hpp">
#pragma once
#include <cmath>

namespace FC { namespace Math {

struct Vector3f {
    float x, y, z;
    constexpr Vector3f() : x(0.f), y(0.f), z(0.f) {}
    constexpr Vector3f(float x_, float y_, float z_) : x(x_), y(y_), z(z_) {}

    Vector3f  operator+ (const Vector3f& r) const { return {x+r.x, y+r.y, z+r.z}; }
    Vector3f  operator- (const Vector3f& r) const { return {x-r.x, y-r.y, z-r.z}; }
    Vector3f  operator* (float s)           const { return {x*s,   y*s,   z*s  }; }
    Vector3f  operator/ (float s)           const { float i=1.f/s; return {x*i,y*i,z*i}; }
    Vector3f& operator+=(const Vector3f& r) { x+=r.x; y+=r.y; z+=r.z; return *this; }
    Vector3f& operator-=(const Vector3f& r) { x-=r.x; y-=r.y; z-=r.z; return *this; }
    Vector3f& operator*=(float s)           { x*=s;   y*=s;   z*=s;   return *this; }
    Vector3f  operator- ()                  const { return {-x,-y,-z}; }

    float    dot  (const Vector3f& r) const { return x*r.x+y*r.y+z*r.z; }
    Vector3f cross(const Vector3f& r) const {
        return {y*r.z-z*r.y, z*r.x-x*r.z, x*r.y-y*r.x};
    }
    float normSq() const { return x*x+y*y+z*z; }
    float norm()   const { return sqrtf(normSq()); }
    bool normalise() {
        float n2=normSq(); if(n2<1e-12f) return false;
        float inv=1.f/sqrtf(n2); x*=inv; y*=inv; z*=inv; return true;
    }
    Vector3f normalised() const {
        float inv=1.f/sqrtf(normSq()+1e-30f); return {x*inv,y*inv,z*inv};
    }
    Vector3f clamped(float lim) const {
        auto cl=[lim](float v){return v>lim?lim:(v<-lim?-lim:v);};
        return {cl(x),cl(y),cl(z)};
    }
    static Vector3f zero()  { return {0.f,0.f,0.f}; }
    static Vector3f zAxis() { return {0.f,0.f,1.f}; }
};
inline Vector3f operator*(float s, const Vector3f& v) { return v*s; }

}} // FC::Math
</file>

<file path="drone_fc/src/safety/safety_monitor.cpp">
#include "safety_monitor.hpp"
#include "../../Inc/fc_config.h"
#include "stm32f7xx_hal.h"
#include <cmath>

extern IWDG_HandleTypeDef hiwdg;
extern ADC_HandleTypeDef  hadc1;

namespace FC { namespace Safety {

void SafetyMonitor::init(){prevDrdyCount_=drdyStallMs_=0;battVoltFilt_=12.6f;wasArmed_=false;armedSinceTick_=0;}

void SafetyMonitor::taskEntry(void* arg){
    SafetyMonitor* s=static_cast<SafetyMonitor*>(arg);
    s->init();
    for(;;){uint32_t t=osKernelGetTickCount();s->update(t);osDelay(10);}
}

void SafetyMonitor::update(uint32_t tick_ms){
    checkIMU(tick_ms); checkRC(); checkTilt();
    checkBattery(); checkGeofence(); checkMotorLoss(); feedWatchdog();
}

void SafetyMonitor::checkIMU(uint32_t){
    uint32_t cur=g_state.imuDrdyCount;
    osMutexAcquire(g_state.imuMtx,osWaitForever);
    const bool readError=g_state.imuReadError;
    osMutexRelease(g_state.imuMtx);
    if(readError){
        drdyStallMs_=0;
        prevDrdyCount_=cur;
        triggerMotorKill(FC_ERR_IMU);
        return;
    }
    if(cur==prevDrdyCount_){
        drdyStallMs_+=10;
        if(drdyStallMs_>=20) triggerMotorKill(FC_ERR_IMU);
    } else {
        drdyStallMs_=0;
        osMutexAcquire(g_state.safetyMtx,osWaitForever);
        g_state.errorFlags&=~FC_ERR_IMU;
        osMutexRelease(g_state.safetyMtx);
    }
    prevDrdyCount_=cur;
}

void SafetyMonitor::checkRC(){
    osMutexAcquire(g_state.rcMtx,osWaitForever);
    bool valid=g_state.rc.valid;
    osMutexRelease(g_state.rcMtx);
    FlightMode m=g_state.mode;
    if(!valid){
        if(m==FlightMode::FPV||m==FlightMode::CAMERA) triggerFailsafe(FC_ERR_RC_LOSS);
        else {osMutexAcquire(g_state.safetyMtx,osWaitForever);g_state.errorFlags|=FC_ERR_RC_LOSS;osMutexRelease(g_state.safetyMtx);}
    } else {
        osMutexAcquire(g_state.safetyMtx,osWaitForever);g_state.errorFlags&=~FC_ERR_RC_LOSS;osMutexRelease(g_state.safetyMtx);
    }
}

void SafetyMonitor::checkTilt(){
    osMutexAcquire(g_state.ahMtx,osWaitForever);
    Math::Quaternionf q=g_state.attitude;
    osMutexRelease(g_state.ahMtx);
    float tilt=acosf(1.f-2.f*(q.x*q.x+q.y*q.y))*(180.f/3.14159265f);
    if(tilt>SAFETY_MAX_TILT_DEG) triggerMotorKill(FC_ERR_TILT_LIMIT);
    else {osMutexAcquire(g_state.safetyMtx,osWaitForever);g_state.errorFlags&=~FC_ERR_TILT_LIMIT;osMutexRelease(g_state.safetyMtx);}
}

void SafetyMonitor::checkBattery(){
    HAL_ADC_Start(&hadc1);
    if(HAL_ADC_PollForConversion(&hadc1,1)==HAL_OK){
        float vAdc=(HAL_ADC_GetValue(&hadc1)/4095.f)*3.3f;
        battVoltFilt_+=kBattAlpha*(vAdc*11.f-battVoltFilt_);
    }
    HAL_ADC_Stop(&hadc1);
    g_state.battery.voltage_v=battVoltFilt_;
    if(battVoltFilt_<SAFETY_CRIT_BATT_V) triggerFailsafe(FC_ERR_LOW_BATT);
    else if(battVoltFilt_<SAFETY_LOW_BATT_V){osMutexAcquire(g_state.safetyMtx,osWaitForever);g_state.errorFlags|=FC_ERR_LOW_BATT;osMutexRelease(g_state.safetyMtx);}
    else {osMutexAcquire(g_state.safetyMtx,osWaitForever);g_state.errorFlags&=~FC_ERR_LOW_BATT;osMutexRelease(g_state.safetyMtx);}
}

void SafetyMonitor::checkGeofence(){
    /* BUG FIX #10: Original used raw lat/lon deltas (1° ≈ 111 km — wrong units).
     * Uses InvEKF NED position in metres from the home origin. */
    osMutexAcquire(g_state.gpsMtx,osWaitForever);
    const GPSData gps=g_state.gps;
    const NavOrigin origin=g_state.origin;
    osMutexRelease(g_state.gpsMtx);
    if(!gps.fixValid || !origin.set) return;
    osMutexAcquire(g_state.navMtx,osWaitForever);
    Math::Vector3f p=g_state.position_ned;
    osMutexRelease(g_state.navMtx);
    float dist=sqrtf(p.x*p.x+p.y*p.y);
    if(dist>SAFETY_GPS_FENCE_M) triggerFailsafe(FC_ERR_GPS_FENCE);
    else {osMutexAcquire(g_state.safetyMtx,osWaitForever);g_state.errorFlags&=~FC_ERR_GPS_FENCE;osMutexRelease(g_state.safetyMtx);}
}

void SafetyMonitor::checkMotorLoss(){
    if(g_state.armState!=ArmState::ARMED){wasArmed_=false;return;}
    const uint32_t now=osKernelGetTickCount();
    if(!wasArmed_){wasArmed_=true;armedSinceTick_=now;}
    const uint32_t elapsedMs=static_cast<uint32_t>(
        (static_cast<uint64_t>(now-armedSinceTick_)*1000u)/osKernelGetTickFreq());
    if(elapsedMs<500u) return; /* allow ESC telemetry to start after arming */
    const uint32_t primask=__get_PRIMASK();
    __disable_irq();
    int losses=0;
    for(int i=0;i<4;i++) if(!g_state.motorTelem[i].valid) losses++;
    __set_PRIMASK(primask);
    if(losses>=2) triggerMotorKill(FC_ERR_MOTOR_LOSS); /* 2+ motors silent → kill */
}

void SafetyMonitor::feedWatchdog(){
    /* BUG FIX #11: original called while(1) with no watchdog feed on faults.
     * IWDG would fire and reset the MCU, which is the correct behaviour,
     * but no reporting happened. Now watchdog feed is explicit and normal faults
     * trigger controlled failsafe instead of locking up. */
    HAL_IWDG_Refresh(&hiwdg);
}

void SafetyMonitor::triggerFailsafe(uint32_t errBit){
    osMutexAcquire(g_state.safetyMtx,osWaitForever);
    g_state.errorFlags|=errBit;
    osMutexRelease(g_state.safetyMtx);
    if(g_state.mode==FlightMode::FPV||g_state.mode==FlightMode::CAMERA)
        g_state.mode=FlightMode::FAILSAFE;
}

void SafetyMonitor::triggerMotorKill(uint32_t errBit){
    osMutexAcquire(g_state.safetyMtx,osWaitForever);
    g_state.errorFlags|=errBit;
    g_state.killMotors=true;
    osMutexRelease(g_state.safetyMtx);
}

}} // FC::Safety
</file>

