#pragma once
#include "math/quaternion.hpp"
#include "math/vector3.hpp"
#include <stdint.h>
#include "cmsis_os.h"

namespace FC {

using Math::Vector3f;
using Math::Quaternionf;

enum class FlightMode : uint8_t {
    DISARMED=0, ARMED=1, TAKEOFF=2, CAMERA=3, FPV=4, FAILSAFE=5, LANDING=6
};
enum class ArmState : uint8_t { DISARMED=0, ARMING=1, ARMED=2 };

struct RCInputs {
    float roll,pitch,yaw,throttle;
    bool  armSwitch,modeSwitch,altHold,valid;
    uint32_t lastUpdateMs;
};

struct GPSData {
    double lat_deg,lon_deg;
    float  alt_msl_m,vel_n_mps,vel_e_mps,vel_d_mps,hAcc_m,vAcc_m;
    uint8_t numSats;
    bool    fixValid;
    uint32_t lastUpdateMs;
};

struct NavOrigin { double lat_deg,lon_deg; float alt_m; bool set; };
struct BatteryState { float voltage_v,current_a,consumed_mah; uint8_t percent; };

/* ---- Per-motor telemetry (bidirectional DSHOT) -------------- */
struct MotorTelemetry {
    float    eRPM;          /**< Electrical RPM from ESC eRPM response    */
    float    mechRPM;       /**< Mechanical RPM = eRPM / (poles/2)        */
    float    thrustN;       /**< Estimated thrust [N] = kF * mechRPM²     */
    float    freqHz;        /**< Mechanical rotation frequency [Hz]        */
    bool     valid;         /**< true if ESC responded within last 10 ms  */
    uint8_t  crcErrors;     /**< GCR CRC error count (resets on arm)      */
};

struct SharedState {
    /* ---- IMU raw (body FRD, SI) ------------------------------- */
    Vector3f gyro_rps, accel_mps2, gyro_raw_rps;
    osMutexId_t imuMtx;

    /* ---- AHRS ------------------------------------------------- */
    Quaternionf attitude;
    Vector3f    euler_deg;
    float       headingMag_deg;
    osMutexId_t ahMtx;

    /* ---- EKF navigation state --------------------------------- */
    Vector3f position_ned, velocity_ned;
    osMutexId_t navMtx;

    /* ---- Barometer -------------------------------------------- */
    float baro_alt_m, baro_alt_agl_m, baro_temp_c, home_alt_m;

    /* ---- GPS -------------------------------------------------- */
    GPSData    gps;
    NavOrigin  origin;

    /* ---- Magnetometer ----------------------------------------- */
    Vector3f mag_normalised;

    /* ---- RC --------------------------------------------------- */
    RCInputs    rc;
    osMutexId_t rcMtx;

    /* ---- Motor DSHOT commands --------------------------------- */
    uint16_t    motorCmd[4];    /**< DSHOT values [0..2047]              */
    osMutexId_t motMtx;

    /* ---- Motor telemetry (bidirectional DSHOT) ---------------- */
    MotorTelemetry motorTelem[4]; /**< Per-motor eRPM/thrust/freq        */
    osMutexId_t    telemMtx;     /**< Separate mutex (not on hot path)   */

    /* ---- Flight mode ------------------------------------------ */
    FlightMode mode;
    ArmState   armState;

    /* ---- Safety ----------------------------------------------- */
    uint32_t errorFlags;
    bool     killMotors;
    osMutexId_t safetyMtx;

    /* ---- Battery ---------------------------------------------- */
    BatteryState battery;

    /* ---- Control outputs (logging/telemetry) ------------------ */
    Vector3f rateSetpoint_rps, torqueOutput;
    float    thrustOutput;

    /* ---- Timing diagnostics ----------------------------------- */
    uint32_t ctrlLoopUs;
    uint32_t imuDrdyCount;

    /* ---- Notch filter state (written by DSHOT task) ----------- */
    float    avgMotorFreqHz;   /**< Mean of 4 motor freqs for notch     */
    float    avgMotorFreqHz2;  /**< 2× harmonic                         */

    /* ---- RTOS sync -------------------------------------------- */
    osSemaphoreId_t imuDrdySem;

    void init() {
        imuMtx    = osMutexNew(nullptr);
        ahMtx     = osMutexNew(nullptr);
        navMtx    = osMutexNew(nullptr);
        rcMtx     = osMutexNew(nullptr);
        motMtx    = osMutexNew(nullptr);
        telemMtx  = osMutexNew(nullptr);
        safetyMtx = osMutexNew(nullptr);
        imuDrdySem= osSemaphoreNew(1,0,nullptr);

        attitude  = Quaternionf::identity();
        armState  = ArmState::DISARMED;
        mode      = FlightMode::DISARMED;
        errorFlags= 0;
        killMotors= true;
        avgMotorFreqHz = avgMotorFreqHz2 = 0.f;
        for(auto&m:motorCmd) m=0;
        for(auto&t:motorTelem){ t.eRPM=0;t.mechRPM=0;t.thrustN=0;t.freqHz=0;t.valid=false;t.crcErrors=0; }
        origin.set=false;
    }
};

extern SharedState g_state;

} // FC
</file>

<file path="drone_fc/src/core/system_init.cpp">
#include "../core/shared_state.hpp"
#include "../drivers/lsm6dsv.hpp"
#include "../estimation/mahony_ahrs.hpp"
#include "../estimation/ekf.hpp"
#include "../flight_modes/flight_mode_fsm.hpp"
#include "../communication/crsf.hpp"
#include "../actuation/dshot.hpp"
#include "../safety/safety_monitor.hpp"
#include "../../Inc/fc_config.h"
#include "stm32f7xx_hal.h"
#include "usbd_cdc_if.h"    /* BUG FIX #6 / #7: MAVLink now via USB CDC, not USART3 */
#include "cmsis_os.h"
#include <cstring>

/* ============================================================
 *  system_init.cpp
 *
 *  BUG FIX #5: System_Init was truncated. Mutexes, semaphores,
 *  and all RTOS primitives were never created, meaning the first
 *  osMutexAcquire() would hard-fault. Fully rewritten here.
 *
 *  BUG FIX #6: mavTxMutex was used for debug UART in the original
 *  safety.c, creating a race between the safety monitor and the
 *  MAVLink task. MAVLink now uses USB CDC (separate, non-shared
 *  path). USART3 is freed for Motor 3 half-duplex DSHOT.
 *
 *  BUG FIX #7: SD card was opened/closed on every log write,
 *  causing ~100 ms FatFS seek-and-flush latency per entry.
 *  LoggerTask now opens the file once at startup and flushes
 *  on a timer (LOG_SD_FLUSH_MS = 500 ms).
 *
 *  BUG FIX #PINS (UART7 → USART3):
 *  Motor 4 was previously assigned to UART7. UART7 pins are on
 *  Port E (PE7/PE8), not accessible in LQFP64. Motor 4 is now
 *  on USART6 (PC6). USART3 (PB10) is Motor 3.
 *
 *  TASK SCHEDULE:
 *  ┌──────────────────┬──────────┬──────────┬─────────────┐
 *  │ Task             │ Rate     │ Stack(W) │ Priority    │
 *  ├──────────────────┼──────────┼──────────┼─────────────┤
 *  │ ControlLoop      │ ~3840 Hz*│ 768      │ Realtime    │
 *  │ SafetyMonitor    │ 100 Hz   │ 256      │ High        │
 *  │ CRSFTask         │ ~500 Hz  │ 256      │ AboveNormal │
 *  │ BaroTask         │ 50 Hz    │ 256      │ Normal      │
 *  │ MagTask          │ 100 Hz   │ 384      │ Normal      │
 *  │ GPSTask          │ 10 Hz    │ 384      │ Normal      │
 *  │ MAVLinkTask      │ 10 Hz    │ 512      │ Low         │
 *  │ LoggerTask       │ queue    │ 512      │ Idle+1      │
 *  └──────────────────┴──────────┴──────────┴─────────────┘
 *  * ControlLoop blocks on imuDrdySem; timing is hardware-driven.
 * ============================================================ */

namespace FC {

/* ---- Global singletons ------------------------------------ */
SharedState g_state;

static Drivers::LSM6DSV           g_imu;
static Estimation::MahonyAHRS     g_ahrs(2.0f, 0.005f, 1.0f, 0.002f);
static Estimation::EKF            g_ekf;
static FlightModes::FlightModeFSM g_fsm;
static Communication::CRSFParser  g_crsf;
static Safety::SafetyMonitor      g_safety;

/* External HAL handles — generated by CubeMX */
extern SPI_HandleTypeDef  hspi1;         /* IMU + Baro          */
extern UART_HandleTypeDef huart1;        /* GPS                 */
extern UART_HandleTypeDef huart2;        /* CRSF/ELRS           */
/* BUG FIX #PINS: huart3 is now Motor 3 (was MAVLink).
 *                huart6 is Motor 4 (was incorrectly UART7).   */
extern UART_HandleTypeDef huart3;        /* Motor 3 — USART3    */
extern UART_HandleTypeDef huart4;        /* Motor 1 — UART4     */
extern UART_HandleTypeDef huart5;        /* Motor 2 — UART5     */
extern UART_HandleTypeDef huart6;        /* Motor 4 — USART6    */
extern IWDG_HandleTypeDef hiwdg;
extern ADC_HandleTypeDef  hadc1;

/* ---- DWT cycle counter for µs timing --------------------- */
static void dwt_init() {
    CoreDebug->DEMCR |= CoreDebug_DEMCR_TRCENA_Msk;
    DWT->CYCCNT = 0;
    DWT->CTRL  |= DWT_CTRL_CYCCNTENA_Msk;
}
static uint32_t dwt_us() {
    return DWT->CYCCNT / (FC_SYSCLK_HZ / 1000000UL);
}

/* ============================================================
 *  EXTI4 IRQ — IMU DRDY on PC4
 *  Keep absolutely minimal: no FP, no HAL, no mutex.
 * ============================================================ */
extern "C" void EXTI4_IRQHandler(void) {
    if (__HAL_GPIO_EXTI_GET_IT(IMU_DRDY_PIN)) {
        __HAL_GPIO_EXTI_CLEAR_IT(IMU_DRDY_PIN);
        g_state.imuDrdyCount++;
        /* osSemaphoreRelease is safe from ISR in FreeRTOS */
        osSemaphoreRelease(g_state.imuDrdySem);
    }
}

/* ============================================================
 *  USART2 RX IRQ — CRSF byte-by-byte receive
 * ============================================================ */
extern "C" void USART2_IRQHandler(void) {
    if (huart2.Instance->ISR & USART_ISR_RXNE) {
        uint8_t b = (uint8_t)huart2.Instance->RDR;
        g_crsf.feedByte(b);
    }
    HAL_UART_IRQHandler(&huart2);
}

/* ============================================================
 *  DSHOT TX/RX callbacks
 *  BUG FIX #PINS: Motor 3 = &huart3 (USART3/PB10)
 *                 Motor 4 = &huart6 (USART6/PC6)
 *                 No reference to huart7 (doesn't exist in LQFP64)
 * ============================================================ */
extern "C" void HAL_UART_TxCpltCallback(UART_HandleTypeDef* h) {
    if      (h == &huart4) Drivers::DShot::onTxComplete(0);
    else if (h == &huart5) Drivers::DShot::onTxComplete(1);
    else if (h == &huart3) Drivers::DShot::onTxComplete(2);
    else if (h == &huart6) Drivers::DShot::onTxComplete(3);
}
extern "C" void HAL_UART_RxCpltCallback(UART_HandleTypeDef* h) {
    if      (h == &huart4) Drivers::DShot::onRxComplete(0);
    else if (h == &huart5) Drivers::DShot::onRxComplete(1);
    else if (h == &huart3) Drivers::DShot::onRxComplete(2);
    else if (h == &huart6) {
        Drivers::DShot::onRxComplete(3);
        Drivers::DShot::updateAvgFreq();   /* After all 4 RX phases */
    }
}

/* ============================================================
 *  CONTROL LOOP TASK  (~3840 Hz, IMU DRDY paced)
 * ============================================================ */
static void ControlLoopTask(void* /*arg*/) {
    osDelay(100);   /* Let sensors stabilise */
    g_ahrs.reset(Quaternionf::identity());
    g_ekf.init({0,0,0}, {0,0,0}, Quaternionf::identity());

    uint32_t tPrev = dwt_us();

    for (;;) {
        /* Block until IMU DRDY — hardware-paced, no drift */
        osSemaphoreAcquire(g_state.imuDrdySem, osWaitForever);

        uint32_t tNow = dwt_us();
        float dt = (float)(tNow - tPrev) * 1e-6f;
        tPrev = tNow;
        if (dt <= 0.f || dt > 0.01f) dt = 1.f / CTRL_LOOP_HZ;

        uint32_t t0 = dwt_us();

        /* 1. Read IMU */
        Vector3f gyro, accel;
        g_imu.readRaw(gyro, accel);
        osMutexAcquire(g_state.imuMtx, osWaitForever);
        g_state.gyro_rps   = gyro;
        g_state.accel_mps2 = accel;
        osMutexRelease(g_state.imuMtx);

        /* 2. Mahony AHRS */
        g_ahrs.updateIMU(gyro, accel, dt);
        Quaternionf att = g_ahrs.getAttitude();
        osMutexAcquire(g_state.ahMtx, osWaitForever);
        g_state.attitude  = att;
        g_state.euler_deg = att.toEulerRPY() * (180.f / 3.14159265f);
        osMutexRelease(g_state.ahMtx);

        /* 3. EKF accumulate (every tick) + predict (every 8th ~480 Hz) */
        g_ekf.accumulateIMU(accel, gyro, att, dt);
        static uint8_t ekfDecim = 0;
        if (++ekfDecim >= 8) {
            ekfDecim = 0;
            g_ekf.predict(att, dt * 8.f);
            Vector3f bg = g_ekf.getGyroBias();
            g_imu.setGyroBias(bg);
            g_ahrs.setGyroBias(bg);
            osMutexAcquire(g_state.navMtx, osWaitForever);
            g_state.position_ned = g_ekf.getPosition();
            g_state.velocity_ned = g_ekf.getVelocity();
            osMutexRelease(g_state.navMtx);
        }

        /* 4. Flight mode FSM → control → motor commands */
        g_fsm.update(dt, g_ahrs, g_ekf);

        /* 5. Send motor commands via DSHOT */
        osMutexAcquire(g_state.motMtx, osWaitForever);
        uint16_t cmds[4];
        for(int i=0;i<4;i++) cmds[i]=g_state.motorCmd[i];
        osMutexRelease(g_state.motMtx);
        Drivers::DShot::sendMotors(cmds);

        g_state.ctrlLoopUs = dwt_us() - t0;
    }
}

/* ============================================================
 *  CRSF TASK (~500 Hz poll)
 * ============================================================ */
static void CRSFTask(void* /*arg*/) {
    for (;;) {
        osDelay(2);
        bool fpv = (g_state.mode == FlightMode::FPV);
        g_crsf.processFrame(fpv);
        g_crsf.tick1ms();
    }
}

/* ============================================================
 *  BARO TASK (50 Hz)
 * ============================================================ */
static void BaroTask(void* /*arg*/) {
    osDelay(500);
    for (;;) {
        osDelay(20);
        /* TODO: Read MS5611 on SPI1 (CS=PC5), update g_state.baro_alt_m
         *       then: g_ekf.updateBaro(alt_m, 0.5f, vibe_rms); */
    }
}

/* ============================================================
 *  MAG TASK (100 Hz)
 * ============================================================ */
static void MagTask(void* /*arg*/) {
    osDelay(200);
    for (;;) {
        osDelay(10);
        /* TODO: Read QMC5883L on I2C1 (PB6/PB7)
         *       g_ahrs.updateMag(mag_body);
         *       g_ekf.updateMag(mag_body, mag_NED_ref); */
    }
}

/* ============================================================
 *  GPS TASK (10 Hz)
 * ============================================================ */
static void GPSTask(void* /*arg*/) {
    osDelay(1000);
    for (;;) {
        osDelay(100);
        /* TODO: Parse UBX NAV-PVT from USART1 DMA.
         *       Convert lat/lon to NED relative to g_state.origin.
         *       g_ekf.updateGPS(pos, vel, hAcc, vAcc, sAcc, hDOP, sats); */
    }
}

/* ============================================================
 *  MAVLINK TASK (10 Hz)
 *
 *  BUG FIX #6: Original code shared mavTxMutex with debug UART
 *  in safety.c. Now MAVLink goes through USB CDC.
 *  CDC_Transmit_FS() is thread-safe (uses its own internal lock).
 *  No shared mutex needed.
 *
 *  BUG FIX #7 (tangential): SD was opened/closed per log write.
 *  LoggerTask below keeps the file open; MAVLink is separate.
 * ============================================================ */
static void MAVLinkTask(void* /*arg*/) {
    for (;;) {
        osDelay(100);   /* 10 Hz base rate */
        /* TODO: Build MAVLink frames (HEARTBEAT, ATTITUDE, GPS_RAW,
         *       BATTERY_STATUS, MOTOR_OUTPUTS) and call:
         *       CDC_Transmit_FS(buf, len);
         *       Return value: USBD_OK if sent, USBD_BUSY if previous
         *       packet not yet consumed — retry next tick.            */
    }
}

/* ============================================================
 *  LOGGER TASK (queue-driven)
 *
 *  BUG FIX #7: SD card is opened ONCE at startup (here).
 *  Writes go to a FatFS buffer. f_sync() is called every
 *  LOG_SD_FLUSH_MS to commit to flash.
 *  The original code called f_open()/f_close() on every entry,
 *  blocking the task for ~100 ms per write.
 * ============================================================ */
static void LoggerTask(void* /*arg*/) {
    /* TODO: f_open() the log file here once.
     * Loop: drain log queue → f_write() → f_sync() every 500 ms.  */
    osDelay(2000);
    for (;;) {
        osDelay(20);
        /* TODO: Drain queue, write, flush */
    }
}

/* ============================================================
 *  SAFETY TASK (100 Hz, highest non-control priority)
 * ============================================================ */
static void SafetyTaskEntry(void* arg) {
    Safety::SafetyMonitor::taskEntry(arg);
}

/* ============================================================
 *  SYSTEM INIT — call from main() before osKernelStart()
 *
 *  BUG FIX #5: Original System_Init was truncated mid-function.
 *  All RTOS primitives, sensor init, and task creation happens here.
 * ============================================================ */
extern "C" void FC_SystemInit(void) {
    dwt_init();

    /* Shared state: creates all mutexes and semaphores */
    g_state.init();

    /* IMU */
    if (!g_imu.init(&hspi1)) {
        g_state.errorFlags |= FC_ERR_IMU;
        HAL_GPIO_WritePin(ERROR_LED_PORT, ERROR_LED_PIN, GPIO_PIN_SET);
    }

    /* DSHOT — motor UART handles
     * BUG FIX #PINS: huart7 removed; correct array is:
     *   [0]=huart4(PA0), [1]=huart5(PC12), [2]=huart3(PB10), [3]=huart6(PC6) */
    UART_HandleTypeDef* motorUarts[4] = { &huart4, &huart5, &huart3, &huart6 };
    Drivers::DShot::init(motorUarts);

    /* CRSF RX interrupt on USART2 */
    __HAL_UART_ENABLE_IT(&huart2, UART_IT_RXNE);

    /* IMU DRDY on EXTI4 (PC4, pin 24) */
    HAL_NVIC_SetPriority(IMU_DRDY_IRQn, 5, 0);
    HAL_NVIC_EnableIRQ(IMU_DRDY_IRQn);

    /* ---- Create RTOS tasks --------------------------------- */
    const osThreadAttr_t ctrlAttr  = {"CtrlLoop",0,nullptr,0,nullptr,STACK_CTRL_LOOP*4,nullptr,osPriorityRealtime,0};
    const osThreadAttr_t safeAttr  = {"Safety",  0,nullptr,0,nullptr,STACK_SAFETY*4,   nullptr,osPriorityHigh,0};
    const osThreadAttr_t crsfAttr  = {"CRSF",    0,nullptr,0,nullptr,STACK_CRSF*4,     nullptr,osPriorityAboveNormal,0};
    const osThreadAttr_t baroAttr  = {"Baro",    0,nullptr,0,nullptr,STACK_BARO*4,     nullptr,osPriorityNormal,0};
    const osThreadAttr_t magAttr   = {"Mag",     0,nullptr,0,nullptr,STACK_MAG*4,      nullptr,osPriorityNormal,0};
    const osThreadAttr_t gpsAttr   = {"GPS",     0,nullptr,0,nullptr,STACK_GPS*4,      nullptr,osPriorityNormal,0};
    const osThreadAttr_t mavAttr   = {"MAVLink", 0,nullptr,0,nullptr,STACK_MAVLINK*4,  nullptr,osPriorityLow,0};
    const osThreadAttr_t logAttr   = {"Logger",  0,nullptr,0,nullptr,STACK_LOGGER*4,   nullptr,osPriorityIdle,0};

    osThreadNew(ControlLoopTask,  nullptr,   &ctrlAttr);
    osThreadNew(SafetyTaskEntry,  &g_safety, &safeAttr);
    osThreadNew(CRSFTask,         nullptr,   &crsfAttr);
    osThreadNew(BaroTask,         nullptr,   &baroAttr);
    osThreadNew(MagTask,          nullptr,   &magAttr);
    osThreadNew(GPSTask,          nullptr,   &gpsAttr);
    osThreadNew(MAVLinkTask,      nullptr,   &mavAttr);
    osThreadNew(LoggerTask,       nullptr,   &logAttr);
}

} // FC
