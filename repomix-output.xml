<file path="drone_fc/src/communication/crsf.hpp">
#pragma once
#include <stdint.h>
#include "../../Inc/fc_config.h"

namespace FC { namespace Communication {

/** CRSF/ELRS RC Protocol Parser
 *
 * BUG FIX #1: `0.07FF` float literal used as bitmask — CH2-CH16 garbage. Fixed to 0x07FFu.
 * BUG FIX #2: No CRC validation. Fixed with CRC8/DVB-S2 on every frame.
 * BUG FIX #3: No failsafe timeout. Fixed: 300 ms triggers rc.valid=false.
 * BUG FIX #4: Raw [172-1811] fed to PID. Fixed: normalise + deadband + expo in processFrame().
 */
class CRSFParser {
public:
    static constexpr uint8_t  CRSF_ADDR_FC      = 0xC8u;
    static constexpr uint8_t  CRSF_FRAMETYPE_RC = 0x16u;
    static constexpr int      CRSF_MAX_FRAME    = 64;
    static constexpr int      NUM_CHANNELS      = 16;
    static constexpr uint16_t CH_MIN=172u, CH_MID=992u, CH_MAX=1811u;
    static constexpr uint16_t SW_HIGH=1600u;

    CRSFParser(){reset();}
    void feedByte(uint8_t b);
    void processFrame(bool fpvMode);
    void tick1ms();

    uint16_t getRawChannel(int ch)const{return(ch>=0&&ch<NUM_CHANNELS)?raw_[ch]:CH_MID;}
    bool isFrameReady()const{return frameReady_;}
    void clearFrameReady(){frameReady_=false;}

    static float normaliseChannel(uint16_t raw){
        float span=(raw>=CH_MID)?(float)(CH_MAX-CH_MID):(float)(CH_MID-CH_MIN);
        float n=((float)raw-(float)CH_MID)/span;
        return n>1.f?1.f:(n<-1.f?-1.f:n);
    }
    static float normaliseThrottle(uint16_t raw){
        float n=(float)(raw-CH_MIN)/(float)(CH_MAX-CH_MIN);
        return n>1.f?1.f:(n<0.f?0.f:n);
    }
    static float applyDeadbandExpo(float v,float db,float expo){
        if(v>db) v=(v-db)/(1.f-db);
        else if(v<-db) v=(v+db)/(1.f-db);
        else return 0.f;
        return (1.f-expo)*v+expo*v*v*v;
    }

private:
    enum class ParseState:uint8_t{WAIT_ADDR,WAIT_LEN,WAIT_DATA};
    uint8_t    buf_[CRSF_MAX_FRAME]; uint8_t bufIdx_=0,frameLen_=0;
    ParseState parseState_=ParseState::WAIT_ADDR;
    uint16_t   raw_[NUM_CHANNELS];
    bool       frameReady_=false;
    uint32_t   msSinceLastFrame_=0;
    static constexpr uint32_t kFailsafeMs=300u;
    void reset(); static uint8_t crc8dvbs2(const uint8_t*,uint8_t);
    void unpackChannels(const uint8_t*);
};

}} // FC::Communication
</file>

<file path="drone_fc/src/control/attitude_controller.hpp">
#pragma once
#include "../math/quaternion.hpp"
#include "../math/vector3.hpp"
#include "pid.hpp"

namespace FC { namespace Control {
using Math::Quaternionf;
using Math::Vector3f;

/* BUG FIX #8: Original code had no attitude controller at all — the
 * single PID fed angle error directly to motors. This implements the
 * quaternion-error middle loop that sits between the velocity controller
 * and the rate controller. */

class AttitudeController {
public:
    struct Gains {
        float kp_roll=7.f, kp_pitch=7.f, kp_yaw=3.5f;
        float rate_max_roll_rps=3.84f;   /* ~220 deg/s */
        float rate_max_pitch_rps=3.84f;
        float rate_max_yaw_rps=2.79f;    /* ~160 deg/s */
    };

    static Gains cameraGains(){return Gains{};}

    explicit AttitudeController(const Gains& g=cameraGains()):g_(g),desiredYaw_(0){}

    void setGains(const Gains& g){g_=g;}

    /** Compute rate setpoint from quaternion attitude error.
     *  q_err = q_desired ⊗ q_current⁻¹
     *  rate_sp = 2 × Kp × q_err.xyz   (shortest-path, bounded to rate limits) */
    Vector3f update(const Quaternionf& q_desired, const Quaternionf& q_current){
        Quaternionf e=Quaternionf::attitudeError(q_desired,q_current);
        auto cl=[](float v,float l){return v>l?l:(v<-l?-l:v);};
        return {
            cl(2.f*g_.kp_roll *e.x, g_.rate_max_roll_rps),
            cl(2.f*g_.kp_pitch*e.y, g_.rate_max_pitch_rps),
            cl(2.f*g_.kp_yaw  *e.z, g_.rate_max_yaw_rps)
        };
    }

    /** Build desired quaternion from normalised tilt commands [-1..+1] and yaw rate. */
    Quaternionf buildDesiredAttitude(float roll_cmd, float pitch_cmd,
                                     float yaw_rate_rps,
                                     float max_roll_rad, float max_pitch_rad,
                                     float dt)
    {
        desiredYaw_ += yaw_rate_rps*dt;
        while(desiredYaw_> 3.14159f) desiredYaw_-=6.28318f;
        while(desiredYaw_<-3.14159f) desiredYaw_+=6.28318f;
        return Quaternionf::fromEulerRPY(roll_cmd*max_roll_rad,
                                          pitch_cmd*max_pitch_rad,
                                          desiredYaw_);
    }

    void captureYaw(float yaw_rad){desiredYaw_=yaw_rad;}
    void reset(){desiredYaw_=0.f;}
    float getDesiredYaw()const{return desiredYaw_;}

private:
    Gains g_;
    float desiredYaw_;
};

}} // FC::Control
</file>

<file path="drone_fc/src/control/pid.hpp">
#pragma once
#include <cmath>
namespace FC { namespace Control {

class PID {
public:
    struct Gains {
        float kp=0,ki=0,kd=0,kff=0;
        float tau_d=0.002f, i_max=1e6f, out_max=1e6f;
    };
    explicit PID(const Gains& g=Gains()):g_(g){reset();}
    void setGains(const Gains& g){g_=g;}
    const Gains& getGains()const{return g_;}

    float update(float setpoint, float measured, float dt){
        if(dt<=0.f||dt>0.5f)return 0.f;
        float err=setpoint-measured;
        float p=g_.kp*err;
        float d_raw=(err-prevErr_)/dt;
        float alpha=dt/(g_.tau_d+dt);
        d_filt_+=alpha*(d_raw-d_filt_);
        float d=g_.kd*d_filt_;
        float u_no_int=p+d+g_.kff*setpoint;
        float i_inc=g_.ki*err*dt;
        float sat_chk=u_no_int+integral_;
        bool sat=(sat_chk>g_.out_max&&i_inc>0)||(sat_chk<-g_.out_max&&i_inc<0);
        if(!sat){
            integral_+=i_inc;
            if(integral_>g_.i_max)integral_=g_.i_max;
            else if(integral_<-g_.i_max)integral_=-g_.i_max;
        }
        prevErr_=err;
        float out=u_no_int+integral_;
        if(out>g_.out_max)out=g_.out_max;
        else if(out<-g_.out_max)out=-g_.out_max;
        return out;
    }
    void  reset(){integral_=0;prevErr_=0;d_filt_=0;}
    void  setIntegral(float v){integral_=v;}
    float getIntegral()const{return integral_;}
private:
    Gains g_; float integral_=0,prevErr_=0,d_filt_=0;
};

}} // FC::Control
</file>

